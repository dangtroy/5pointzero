 2px solid transparent;\n}\n\n\/* Hover effect *\/\n.flex-block:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 6px 12px rgba(0,0,0,0.15);\n}\n\n\/* RED DOT ON ACTIVE *\/\n.flex-block.active::before {\n  content: \"\";\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  width: 8px;\n  height: 8px;\n  background-color: red;\n  border-radius: 50%;\n  z-index: 2;\n}\n\n\/* === INDIVIDUAL BLOCK COLORS === *\/\n.block-1 {\n  background-color: #E8FFC6;\n  border-color: #96FF00;\n  color: #1D1D1D;\n}\n.block-1 .strike,\n.block-1 .bold,\n.block-1 p {\n  color: #1D1D1D;\n}\n\n.block-2 {\n  background-color: #96FF00;\n  border-color: #D9D9D9;\n  color: #1D1D1D;\n}\n.block-2 .strike,\n.block-2 .bold,\n.block-2 p {\n  color: #1D1D1D;\n}\n\n.block-3 {\n  background-color: #000000;\n  border-color: #D9D9D9;\n  color: #96FF00;\n}\n.block-3 .strike,\n.block-3 .bold,\n.block-3 p {\n  color: #96FF00;\n}\n\n\/* Text styles *\/\n.flex-block h3 {\n  margin: 5px 0 6px;\n  font-size: 18px;\n  font-weight: 700;\n}\n.flex-block p {\n  margin: 0;\n  font-size: 10px;\n  font-weight: bold;\n}\n\n\/* Pricing styles *\/\n.price_cover {\n  margin-bottom: 8px;\n}\n.price {\n  font-size: 16px;\n  display: inline-block;\n  margin-right: 5px;\n}\n.strike {\n  text-decoration: line-through;\n}\n.bold {\n  font-weight: bold;\n}\n\n\/* Responsive *\/\n@media (max-width: 768px) {\n  .flex-row-3 {\n    flex-wrap: nowrap;\n  }\n  .flex-row-3 a {\n    flex: 1 1 33.33%;\n  }\n  .flex-block {\n    font-size: 14px;\n    padding: 15px;\n  }\n  .flex-block h3 {\n    font-size: 14px;\n  }\n  .flex-block p,\n  .price {\n    font-size: 12px;\n  }\n}\n<\/style>\n\n<div class=\"flex-row-3\">\n  <a href=\"\/pages\/1x-perform\" class=\"flex-block block-1 {% if request.path == '\/pages\/1x-perform' %}active{% endif %}\">\n    <div class=\"price_cover\">\n      <span class=\"price strike\">$59<\/span>\n      <span class=\"price bold\">$49<\/span>\n    <\/div>\n    <h3>1 PERFORM - 30 Servings<\/h3>\n    <p>YOU