{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient" id="img_become">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="custom_iwt_cover">
        <div class="custom_iwt_inner {% if section.settings.image_first %}custom_iwt_image_first{% endif %}">
         <div class="custom_iwt_text">
            <div class="custom_iwt_inside">
           <div class="custom_iwt_header">
             {% if section.settings.caption != blank %}<span>{{ section.settings.caption }}</span>{% endif %}
             {% if section.settings.heading != blank %}
            <h2
              class="rich-text__heading rte inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
              {{ section.settings.heading }}
            </h2>
         {% endif %}
         {% if section.settings.hilight != blank %}<h3 style="">{{ section.settings.hilight }}</h3>{% endif %}
        {% if section.settings.content != blank %} <div class="content">{{ section.settings.content }}</div>{% endif %}

<div class="title_2_another">
             {% if section.settings.heading2 != blank %}
            <h2
              class="rich-text__heading rte inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
              {{ section.settings.heading2 }}
            </h2>
         {% endif %}
  {% if section.settings.content2 != blank %} <div class="content">{{ section.settings.content2 }}</div>{% endif %}
</div>
           </div>
           <div class="custom_iwt_btn">
             {%- if section.settings.button_label != blank -%}
                  <a
                    {% if section.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ section.settings.button_link }}"
                    {% endif %}
                    class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} {% if section.settings.button_green %}button_arrow_green{% endif %}"
                  >
                    {{- section.settings.button_label | escape -}} <svg xmlns="http://www.w3.org/2000/svg" width="53" height="12" viewBox="0 0 53 12" fill="none">
<path d="M1.57617 5.39648C1.16196 5.39648 0.826172 5.73227 0.826172 6.14648C0.826172 6.5607 1.16196 6.89648 1.57617 6.89648V5.39648ZM52.1065 6.67681C52.3994 6.38392 52.3994 5.90905 52.1065 5.61615L47.3335 0.843184C47.0406 0.55029 46.5658 0.55029 46.2729 0.843184C45.98 1.13608 45.98 1.61095 46.2729 1.90384L50.5155 6.14648L46.2729 10.3891C45.98 10.682 45.98 11.1569 46.2729 11.4498C46.5658 11.7427 47.0406 11.7427 47.3335 11.4498L52.1065 6.67681ZM1.57617 6.89648H51.5762V5.39648H1.57617V6.89648Z" fill="black"/>
</svg>
                  </a>
                {%- endif -%}
<div class="btn_ige1_cust_cover">
<div class="btn_ige1_cust">$590 VALUE</div>
<div class="btn_ige2_cust">$390</div>
  <div class="btn_ige3_cust">YOU SAVE $200!</div>
</div>
           </div>
</div>
         </div>
        
          <div class="custom_iwt_image">
             
            <ul>
              {% for block in section.blocks %}
              <li style="width:{{ block.settings.text_alignment_mobile }}%;">
                <a data-fancybox data-src="{{ block.settings.img | img_url:"1920x" }}">
                <img src="{{ block.settings.img | img_url:"master" }}" alt=""/>
              </a>
              </li>
              {% endfor %}
            </ul>
          </div>
      
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multi Image With Text",
  "tag": "section",
  "class": "section custom_image_with_text multi_image_text",
  "settings": [ 
    {
      "type": "checkbox",
      "id": "image_first",
      "label": "Enable Image First"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.rich-text.blocks.heading.settings.heading.default",
      "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "hilight",
      "label": "Hilighted Text"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.rich-text.blocks.buttons.settings.button_label_1.default",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
      "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "t:sections.rich-text.blocks.buttons.settings.button_style_secondary_1.label"
    },
    {
      "type": "checkbox",
      "id": "button_green",
      "default": false,
      "label": "Button Arrow Green"
    },
    {
      "type": "richtext",
      "id": "pr_text",
      "label": "Button Sub Text"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Main Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading2",
      "label": "Heading 2"
    },
    {
      "type": "richtext",
      "id": "content2",
      "label": "Content 2"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "text_alignment_mobile",
          "options": [
            {
              "value": "33.33",
              "label": "33.33%"
            },
            {
              "value": "50",
              "label": "50%"
            },
            {
              "value": "100",
              "label": "100%"
            }
          ],
          "default": "33.33",
          "label": "Image Column"
        }
      ]
    } 
  ],
  "presets": [
    {
      "name": "Multi Image With Text"
    }
  ]
}
{% endschema %}
