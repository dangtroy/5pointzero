{% comment %}
  PZ Benefit Grid — the "5 Benefits" section.
  Five distinct benefit cards: large stroke icons in the primary ink color,
  an indexed 01-05 counter in the accent, minimal card treatment.
  Desktop: five across. Mobile: a snapping horizontal row (five items do
  not divide cleanly into two columns, and the rest of the page already
  uses scroll rows).
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-benefits pz-benefits-{{ section.id }}">
  {% style %}
    .pz-benefits-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 56px 0;
      scroll-margin-top: 80px;
    }
    @media (min-width: 600px) {
      .pz-benefits-{{ section.id }} { padding: 88px 0; }
    }
    .pz-benefits-{{ section.id }} .pz-benefits-head {
      max-width: 1280px; margin: 0 auto 40px; padding: 0 16px; text-align: center;
    }
    @media (min-width: 600px) {
      .pz-benefits-{{ section.id }} .pz-benefits-head { padding: 0 24px; margin-bottom: 56px; }
    }
    .pz-benefits-{{ section.id }} h2 {
      font-size: clamp(26px, 3.6vw, 42px); font-weight: 900; margin: 0 0 12px;
      color: {{ section.settings.heading_color }};
      text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05;
    }
    .pz-benefits-{{ section.id }} .pz-benefits-sub {
      font-size: clamp(15px, 1.5vw, 17px); opacity: .65; max-width: 46ch; margin: 0 auto;
    }

    /* Desktop: five across. */
    .pz-benefits-{{ section.id }} .pz-benefits-grid {
      max-width: 1280px; margin: 0 auto; padding: 0 24px;
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px;
    }
    /* Mobile / tablet: one snapping row rather than a 2+2+1 orphan. */
    @media (max-width: 900px) {
      .pz-benefits-{{ section.id }} .pz-benefits-grid {
        display: flex; gap: 12px; padding: 4px 16px 14px;
        overflow-x: auto; scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch; scrollbar-width: none;
      }
      .pz-benefits-{{ section.id }} .pz-benefits-grid::-webkit-scrollbar { display: none; }
      .pz-benefits-{{ section.id }} .pz-benefit-card {
        flex: 0 0 62vw; max-width: 260px; scroll-snap-align: start;
      }
    }

    .pz-benefits-{{ section.id }} .pz-benefit-card {
      min-width: 0; position: relative;
      display: flex; flex-direction: column; align-items: flex-start; text-align: left;
      padding: 26px 22px 24px;
      border: 1px solid {{ section.settings.border_color }};
      border-radius: 14px;
      background: {{ section.settings.card_background }};
      transition: border-color .2s ease, transform .2s ease;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-card:hover {
      border-color: {{ section.settings.accent_color }};
      transform: translateY(-2px);
    }
    @media (prefers-reduced-motion: reduce) {
      .pz-benefits-{{ section.id }} .pz-benefit-card { transition: none; }
      .pz-benefits-{{ section.id }} .pz-benefit-card:hover { transform: none; }
    }

    /* Index counter — the accent lives here and on the rule, not as a
       large filled shape behind the icon. */
    .pz-benefits-{{ section.id }} .pz-benefit-index {
      font-size: 12px; font-weight: 900; letter-spacing: .12em;
      color: {{ section.settings.accent_on_light_color }};
      margin-bottom: 18px;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-icon {
      color: {{ section.settings.icon_color }};
      margin-bottom: 18px; display: block;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-icon svg {
      width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;
      display: block;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-icon img {
      width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;
      object-fit: contain; display: block;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-rule {
      width: 28px; height: 3px; border-radius: 2px;
      background: {{ section.settings.accent_color }};
      margin-bottom: 14px;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-title {
      font-weight: 900; font-size: clamp(16px, 1.35vw, 19px);
      text-transform: uppercase; letter-spacing: .01em;
      margin-bottom: 8px; line-height: 1.1;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-desc {
      font-size: 14px; opacity: .7; line-height: 1.5;
    }

    /* Optional product spotlight head: pack shot + eyebrow + tagline. */
    .pz-benefits-{{ section.id }} .pz-benefits-pack img {
      display: block; width: 100%; height: auto; max-width: 200px; margin: 0 auto 20px;
      filter: drop-shadow(0 14px 24px rgba(0,0,0,.18));
    }
    .pz-benefits-{{ section.id }} .pz-benefits-eyebrow {
      display: inline-block; margin: 0 0 12px;
      font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      color: {{ section.settings.accent_on_light_color }};
    }
    .pz-benefits-{{ section.id }} .pz-benefits-foot {
      text-align: center; margin-top: 36px; padding: 0 16px;
    }
    .pz-benefits-{{ section.id }} .pz-benefits-label-btn {
      appearance: none; cursor: pointer; font: inherit;
      display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
      padding: 14px 30px; border-radius: 60px;
      border: 2px solid {{ section.settings.heading_color }};
      background: transparent; color: {{ section.settings.heading_color }};
      font-weight: 900; font-size: 15px; letter-spacing: .06em; text-transform: uppercase;
      text-decoration: none;
    }
    .pz-benefits-{{ section.id }} .pz-benefits-label-btn:hover {
      background: {{ section.settings.heading_color }}; color: {{ section.settings.background }};
    }
    .pz-benefits-{{ section.id }} dialog.pz-label-dialog {
      border: 0; border-radius: 14px; padding: 16px; max-width: min(92vw, 720px);
      background: #fff;
    }
    .pz-benefits-{{ section.id }} dialog.pz-label-dialog::backdrop { background: rgba(0,0,0,.7); }
    .pz-benefits-{{ section.id }} .pz-label-dialog img { display: block; width: 100%; height: auto; }
    .pz-benefits-{{ section.id }} .pz-label-close {
      display: block; margin: 0 0 10px auto; min-height: 44px; min-width: 44px;
      border: 0; background: #111; color: #fff; border-radius: 22px; padding: 0 16px;
      font-weight: 700; cursor: pointer;
    }
  {% endstyle %}

  <div class="pz-benefits-head">
    {% assign spot = section.settings.product %}
    {% if spot != blank and spot.featured_image %}
      <a class="pz-benefits-pack" href="{{ spot.url }}">
        {{ spot.featured_image | image_url: width: 600 | image_tag: alt: spot.title, loading: 'lazy', sizes: '200px', widths: '200, 400, 600' }}
      </a>
    {% endif %}
    {% if section.settings.eyebrow != blank %}<span class="pz-benefits-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-benefits-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="pz-benefits-grid">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        {%- liquid
          assign idx = forloop.index
          if idx < 10
            assign idx = idx | prepend: '0'
          endif
        -%}
        <div class="pz-benefit-card" {{ block.shopify_attributes }}>
          {% if section.settings.show_index %}
            <div class="pz-benefit-index">{{ idx }}</div>
          {% endif %}
          <span class="pz-benefit-icon">
            {% case block.settings.icon %}
              {% when 'droplet' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 4c0 0 13 14.5 13 23a13 13 0 0 1-26 0C11 18.5 24 4 24 4Z"/><path d="M18 27a6 6 0 0 0 6 6"/></svg>
              {% when 'bolt' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M27 4 10 27h12l-3 17 17-23H24l3-17Z"/></svg>
              {% when 'pulse' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 24h9l5-13 8 26 6-16 4 3h10"/></svg>
              {% when 'target' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="19"/><circle cx="24" cy="24" r="11"/><circle cx="24" cy="24" r="3.5" fill="currentColor" stroke="none"/></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 4 7 11v13c0 11 7.4 18.9 17 21 9.6-2.1 17-10 17-21V11L24 4Z"/><path d="M17 24l5 5 9-10"/></svg>
              {% when 'no-cramp' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 4 7 11v13c0 11 7.4 18.9 17 21 9.6-2.1 17-10 17-21V11L24 4Z"/><path d="M17 24l5 5 9-10"/></svg>
              {% when 'snowflake' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 4v40M6.7 14l34.6 20M6.7 34l34.6-20"/><path d="M19 7l5 5 5-5M19 41l5-5 5 5M8 21l7-2-2-7M40 27l-7 2 2 7M8 27l7 2-2 7M40 21l-7-2 2-7"/></svg>
              {% when 'muscle' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18v12M12 13v22M36 13v22M42 18v12M12 24h24"/></svg>
              {% when 'joint' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 4v14M31 4v14M17 30v14M31 30v14"/><path d="M14 18h20a4 4 0 0 1 0 8H14a4 4 0 0 1 0-8Z"/><path d="M14 22c0 4.5 4.5 8 10 8s10-3.5 10-8"/></svg>
              {% when 'bone' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 30 30 14a5 5 0 1 1 6.5-6.5A5 5 0 1 1 40.5 14 5 5 0 0 1 34 18L18 34a5 5 0 1 1-6.5 6.5A5 5 0 1 1 7.5 34 5 5 0 0 1 14 30Z"/></svg>
              {% when 'cell' %}
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="19"/><circle cx="21" cy="22" r="7"/><circle cx="34" cy="32" r="2.5"/><circle cx="33" cy="14" r="1.8"/><circle cx="14" cy="34" r="1.8"/></svg>
              {% when 'image' %}
                {% if block.settings.custom_icon %}
                  {{ block.settings.custom_icon | image_url: width: 160 | image_tag: alt: block.settings.title }}
                {% endif %}
            {% endcase %}
          </span>
          <span class="pz-benefit-rule" aria-hidden="true"></span>
          <div class="pz-benefit-title">{{ block.settings.title }}</div>
          {% if block.settings.description != blank %}
            <div class="pz-benefit-desc">{{ block.settings.description | newline_to_br }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {%- liquid
    assign label_src = blank
    if section.settings.label_image
      assign label_src = section.settings.label_image | image_url: width: 1400
    elsif section.settings.label_url != blank
      assign label_src = section.settings.label_url
    endif
  -%}
  {% if section.settings.label_text != blank and label_src != blank %}
    <div class="pz-benefits-foot">
      <button type="button" class="pz-benefits-label-btn"
        onclick="document.getElementById('pz-label-{{ section.id }}').showModal()">
        {{ section.settings.label_text }}
      </button>
      <noscript><a class="pz-benefits-label-btn" href="{{ label_src }}">{{ section.settings.label_text }}</a></noscript>
    </div>
    <dialog class="pz-label-dialog" id="pz-label-{{ section.id }}" aria-label="{{ section.settings.label_text | escape }}"
      onclick="if (event.target === this) this.close()">
      <form method="dialog"><button class="pz-label-close" type="submit">Close</button></form>
      <img src="{{ label_src }}" alt="{{ section.settings.heading | append: ' Supplement Facts label' | escape }}" loading="lazy" width="1400" height="1400">
    </dialog>
  {% endif %}
</section>

{% schema %}
{
  "name": "PZ Benefit Grid",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-benefits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5 Benefits. One Powerful Formula." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "More than just flavored salt water." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small label above the heading" },
    { "type": "product", "id": "product", "label": "Product pack shot", "info": "Shows the product's main image above the heading" },
    { "type": "text", "id": "label_text", "label": "Label button text", "info": "e.g. See PERFORM label. Hidden until a label image is set." },
    { "type": "image_picker", "id": "label_image", "label": "Label image" },
    { "type": "url", "id": "label_url", "label": "Label image URL", "info": "Used when no label image is picked" },
    { "type": "checkbox", "id": "show_index", "label": "Show 01-05 counters", "default": true },
    { "type": "range", "id": "icon_size", "label": "Icon size (px)", "min": 28, "max": 88, "step": 2, "default": 52 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Accent (rule / hover)", "default": "#96FF00" },
    { "type": "color", "id": "accent_on_light_color", "label": "Accent text on light", "info": "Neon green is ~1.3:1 on white — this darker green is used for the counters", "default": "#457300" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#e6e6e6" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet (hydration)" },
            { "value": "bolt", "label": "Bolt (energy)" },
            { "value": "pulse", "label": "Pulse (endurance)" },
            { "value": "target", "label": "Target (focus)" },
            { "value": "shield", "label": "Shield (protection)" },
            { "value": "snowflake", "label": "Snowflake (anti-inflammatory)" },
            { "value": "muscle", "label": "Dumbbell (muscle repair)" },
            { "value": "joint", "label": "Joint (joint support)" },
            { "value": "bone", "label": "Bone (bone support)" },
            { "value": "cell", "label": "Cell (cellular recovery)" },
            { "value": "image", "label": "Custom image" }
          ],
          "default": "droplet"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image", "info": "Only used when Icon is set to Custom image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hydration" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Replenish electrolytes and support hydration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Benefit Grid",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "droplet", "title": "Hydration", "description": "Replenish electrolytes and support hydration." } },
        { "type": "benefit", "settings": { "icon": "bolt", "title": "Energy", "description": "Support energy production and help you stay in the game." } },
        { "type": "benefit", "settings": { "icon": "pulse", "title": "Endurance", "description": "Support sustained performance during play." } },
        { "type": "benefit", "settings": { "icon": "target", "title": "Focus", "description": "Support mental clarity and focus." } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Anti-Cramping", "description": "Support muscle function during activity." } }
      ]
    }
  ]
}
{% endschema %}
