{% comment %}
  PZ Benefit Grid — "5 Benefits" hero-hierarchy section: Hydration, Energy,
  Endurance, Focus, Anti-Cramping. Icon + title + short description cards,
  collapsing from 5-across to 2-across to 1-across on smaller screens.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-benefits pz-benefits-{{ section.id }}">
  {% style %}
    .pz-benefits-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 48px 16px;
      scroll-margin-top: 80px;
    }
    @media (min-width: 600px) {
      .pz-benefits-{{ section.id }} { padding: 64px 24px; }
    }
    .pz-benefits-{{ section.id }} .pz-benefits-head {
      max-width: 1280px; margin: 0 auto 36px; text-align: center;
    }
    .pz-benefits-{{ section.id }} h2 {
      font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px;
      color: {{ section.settings.heading_color }};
    }
    .pz-benefits-{{ section.id }} .pz-benefits-sub { opacity: .75; max-width: 60ch; margin: 0 auto; }
    .pz-benefits-{{ section.id }} .pz-benefits-grid {
      max-width: 1280px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px;
    }
    @media (max-width: 900px) {
      .pz-benefits-{{ section.id }} .pz-benefits-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 600px) {
      .pz-benefits-{{ section.id }} .pz-benefits-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
    .pz-benefits-{{ section.id }} .pz-benefit-card {
      min-width: 0;
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px;
      padding: 24px 16px; border-radius: 16px; background: {{ section.settings.card_background }};
      border: 1px solid {{ section.settings.border_color }};
    }
    .pz-benefits-{{ section.id }} .pz-benefit-icon {
      width: 52px; height: 52px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: {{ section.settings.accent_color }}; color: {{ section.settings.accent_text_color }};
      flex: none;
    }
    .pz-benefits-{{ section.id }} .pz-benefit-title { font-weight: 800; font-size: 15px; }
    .pz-benefits-{{ section.id }} .pz-benefit-desc { font-size: 12px; opacity: .7; line-height: 1.4; }
  {% endstyle %}

  <div class="pz-benefits-head">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-benefits-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="pz-benefits-grid">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="pz-benefit-card" {{ block.shopify_attributes }}>
          <div class="pz-benefit-icon">
            {% case block.settings.icon %}
              {% when 'droplet' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2s7 8.5 7 13a7 7 0 1 1-14 0c0-4.5 7-13 7-13Z"/></svg>
              {% when 'bolt' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 11-14h-7l0-6Z"/></svg>
              {% when 'shield' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
              {% when 'target' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
              {% when 'no-cramp' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              {% when 'image' %}
                {% if block.settings.custom_icon %}
                  {{ block.settings.custom_icon | image_url: width: 80 | image_tag: alt: block.settings.title }}
                {% endif %}
            {% endcase %}
          </div>
          <div class="pz-benefit-title">{{ block.settings.title }}</div>
          {% if block.settings.description != blank %}
            <div class="pz-benefit-desc">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "PZ Benefit Grid",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-benefits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5 Benefits" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "More than just flavored salt water." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Icon background", "default": "#96FF00" },
    { "type": "color", "id": "accent_text_color", "label": "Icon color", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#fafafa" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#ececec" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "shield", "label": "Shield" },
            { "value": "target", "label": "Target" },
            { "value": "no-cramp", "label": "X (anti-cramping)" },
            { "value": "image", "label": "Custom image" }
          ],
          "default": "droplet"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image", "info": "Only used when Icon is set to Custom image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hydration" },
        { "type": "text", "id": "description", "label": "Short description", "default": "5 electrolytes to keep you in the game." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Benefit Grid",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "droplet", "title": "Hydration", "description": "5 electrolytes to keep you in the game." } },
        { "type": "benefit", "settings": { "icon": "bolt", "title": "Energy", "description": "Crash-free energy from natural caffeine." } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Endurance", "description": "Fuel for a full session, start to finish." } },
        { "type": "benefit", "settings": { "icon": "target", "title": "Focus", "description": "L-theanine for smooth, jitter-free clarity." } },
        { "type": "benefit", "settings": { "icon": "no-cramp", "title": "Anti-Cramping", "description": "Magnesium and potassium to keep legs loose." } }
      ]
    }
  ]
}
{% endschema %}
