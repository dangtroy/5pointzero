{% comment %}
  PZ Hero Banner — full-bleed brand photo with the wholesale pitch over it.

  Blur and brightness are settings because how much each photo needs
  varies, but blur costs real detail and should stay at zero unless the
  photo is genuinely busy behind the copy.
{% endcomment %}
<section
  id="{{ section.settings.anchor_id }}"
  class="pzhb pzhb-{{ section.id }} pzhb--{{ section.settings.text_align }}"
>
  {% style %}
    .pzhb-{{ section.id }} {
      --pzw-accent: {{ section.settings.accent_color }};
      --pzw-ink: {{ section.settings.text_color }};
      position: relative;
      display: flex; align-items: center;
      min-height: {{ section.settings.min_height }}svh;
      padding: 72px 16px;
      box-sizing: border-box;
      background: #000;
      color: var(--pzw-ink);
      overflow: hidden;
      isolation: isolate;
    }
    @media (min-width: 750px) {
      .pzhb-{{ section.id }} { padding: 96px 32px; }
    }
    .pzhb-{{ section.id }} .pzhb-media {
      position: absolute; inset: 0; z-index: 0;
    }
    .pzhb-{{ section.id }} .pzhb-media img {
      width: 100%; height: 100%; object-fit: cover;
      object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
      filter: blur({{ section.settings.image_blur }}px)
              brightness({{ section.settings.image_brightness | divided_by: 100.0 }});
      /* The 6% overscan exists only to hide the soft edge blur creates.
         With no blur it would enlarge the photo for nothing, which costs
         real detail on high-density displays. */
      {% if section.settings.image_blur > 0 %}transform: scale(1.06);{% endif %}
    }
    /* Directional scrim: dense behind the copy, clearing toward the subject. */
    .pzhb-{{ section.id }}.pzhb--center .pzhb-media::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to top,
        rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 }}) 0%,
        rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 | times: 0.85 }}) 60%,
        rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 | times: 0.7 }}) 100%);
    }
    .pzhb-{{ section.id }}.pzhb--left .pzhb-media::after {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(100deg,
          rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 }}) 0%,
          rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 | times: 0.8 }}) 38%,
          rgba(0,0,0,.15) 78%),
        linear-gradient(to top, rgba(0,0,0,.6), transparent 42%);
    }
    .pzhb-{{ section.id }}.pzhb--right .pzhb-media::after {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(260deg,
          rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 }}) 0%,
          rgba(0,0,0,{{ section.settings.scrim_strength | divided_by: 100.0 | times: 0.8 }}) 34%,
          rgba(0,0,0,.08) 70%),
        linear-gradient(to top, rgba(0,0,0,.45), transparent 40%);
    }
    @media (max-width: 749px) {
      /* No room to dodge the subject on a phone, so carry the scrim across. */
      .pzhb-{{ section.id }} .pzhb-media::after {
        background: linear-gradient(to top,
          rgba(0,0,0,.88) 0%, rgba(0,0,0,.72) 55%, rgba(0,0,0,.58) 100%);
      }
    }

    .pzhb-{{ section.id }} .pzhb-inner {
      position: relative; z-index: 1;
      width: 100%; max-width: 1180px; margin: 0 auto;
    }
    /* Sized in px, not ch: a ch cap here resolves against the BODY font
       size, not the heading's, so it collapsed the 56px headline to about
       six characters per line. */
    .pzhb-{{ section.id }} .pzhb-copy { max-width: {{ section.settings.copy_width }}px; }
    .pzhb-{{ section.id }}.pzhb--center .pzhb-inner { display: flex; justify-content: center; }
    .pzhb-{{ section.id }}.pzhb--center .pzhb-copy { text-align: center; }
    .pzhb-{{ section.id }}.pzhb--center .pzhb-points { justify-content: center; }
    /* Right: copy column sits on the right, text stays left-aligned within it. */
    .pzhb-{{ section.id }}.pzhb--right .pzhb-inner { display: flex; justify-content: flex-end; }
    @media (max-width: 749px) {
      .pzhb-{{ section.id }} .pzhb-copy { max-width: none; }
    }

    .pzhb-{{ section.id }} .pzhb-eyebrow {
      display: inline-block; margin: 0 0 18px;
      font-size: 12px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--pzw-accent);
    }
    .pzhb-{{ section.id }} .pzhb-heading {
      font-size: clamp(27px, 4.4vw, 56px); font-weight: 900; margin: 0 0 26px;
      text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05;
      color: var(--pzw-ink);
    }

    .pzhb-{{ section.id }} .pzhb-points {
      display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0 0 30px; padding: 0; list-style: none;
    }
    .pzhb-{{ section.id }} .pzhb-point {
      font-size: clamp(19px, 2.6vw, 33px); font-weight: 900;
      text-transform: uppercase; letter-spacing: -0.02em; line-height: 1;
      color: var(--pzw-accent);
    }

    .pzhb-{{ section.id }} .pzhb-sub {
      font-size: clamp(15px, 1.4vw, 17px); line-height: 1.5; opacity: .82;
      margin: 0 0 28px; max-width: 52ch;
    }
    .pzhb-{{ section.id }}.pzhb--center .pzhb-sub { margin-left: auto; margin-right: auto; }
    /* The theme's .button supplies the condensed face, the ring and the
       focus state. These overrides are the same ones the product page
       applies on top of it, so the two buttons match: the theme's own
       colours and metrics would otherwise render this as a ghost button. */
    .pzhb-{{ section.id }} .pzhb-cta {
      min-height: 44px;
      text-decoration: none;
      background: var(--pzw-accent) !important;
      color: #000 !important;
      border-color: var(--pzw-accent) !important;
      border-radius: {{ section.settings.button_radius }}px !important;
      padding-top: 22px !important; padding-bottom: 22px !important;
      font-size: 19px !important;
      font-weight: 900 !important;
      text-transform: uppercase;
      letter-spacing: .06em;
    }
    .pzhb-{{ section.id }} .pzhb-cta:hover { filter: brightness(1.06); }
    .pzhb-{{ section.id }} .pzhb-ctas { display: flex; flex-wrap: wrap; gap: 12px 16px; }
    .pzhb-{{ section.id }}.pzhb--center .pzhb-ctas { justify-content: center; }
    @media (max-width: 749px) {
      .pzhb-{{ section.id }} .pzhb-cta { width: 100%; }
    }

    /* Product packs beside the copy. With two, they flank it (first on the
       left, second on the right); with one, it sits after the copy. */
    /* .pzhb-inner twice in the selector so it outranks the centred
       layout's flex rule (.pzhb-ID.pzhb--center .pzhb-inner). */
    .pzhb-{{ section.id }} .pzhb-inner.pzhb-inner--products {
      display: grid; align-items: center; gap: 24px 40px;
      grid-template-columns: 1fr;
    }
    .pzhb-{{ section.id }} .pzhb-pack { margin: 0; text-align: center; }
    .pzhb-{{ section.id }} .pzhb-pack a { display: inline-block; }
    .pzhb-{{ section.id }} .pzhb-pack img {
      display: block; width: 100%; height: auto;
      max-width: {{ section.settings.product_image_width }}px; margin: 0 auto;
      filter: drop-shadow(0 18px 30px rgba(0,0,0,.55));
    }
    .pzhb-{{ section.id }} .pzhb-pack figcaption {
      margin-top: 10px; font-size: 12px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase; color: var(--pzw-accent);
    }
    @media (max-width: 749px) {
      .pzhb-{{ section.id }} .pzhb-packs-mobile {
        display: flex; justify-content: center; align-items: flex-end; gap: 16px; order: -1;
      }
      .pzhb-{{ section.id }} .pzhb-packs-mobile .pzhb-pack img { max-width: 150px; }
      .pzhb-{{ section.id }} .pzhb-pack--desktop { display: none; }
    }
    @media (min-width: 750px) {
      .pzhb-{{ section.id }} .pzhb-packs-mobile { display: none; }
      .pzhb-{{ section.id }} .pzhb-inner--products.pzhb-inner--two {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr);
      }
      .pzhb-{{ section.id }} .pzhb-inner--products.pzhb-inner--one {
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      }
      .pzhb-{{ section.id }}.pzhb--center .pzhb-inner--products { justify-items: center; }
    }
  {% endstyle %}

  {%- liquid
    assign pack_count = 0
    if section.settings.product_1 != blank and section.settings.product_1.featured_image
      assign pack_count = pack_count | plus: 1
    endif
    if section.settings.product_2 != blank and section.settings.product_2.featured_image
      assign pack_count = pack_count | plus: 1
    endif
  -%}

  {%- liquid
    assign use_picker = false
    if section.settings.image
      assign use_picker = true
    endif
  -%}
  {% if use_picker or section.settings.image_filename != blank %}
    <div class="pzhb-media">
      {% if use_picker %}
        {{ section.settings.image | image_url: width: 2200 | image_tag:
           alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high', sizes: '100vw',
           widths: '750, 1100, 1500, 1900, 2200' }}
      {% else %}
        <img
          src="{{ section.settings.image_filename | asset_url }}"
          {% if section.settings.image_filename_sm != blank %}
            srcset="{{ section.settings.image_filename_sm | asset_url }} 1100w,
                    {{ section.settings.image_filename | asset_url }} 2200w"
            sizes="100vw"
          {% endif %}
          alt="{{ section.settings.image_alt | escape }}"
          width="{{ section.settings.image_width }}" height="{{ section.settings.image_height }}"
          loading="eager" fetchpriority="high" decoding="async">
      {% endif %}
    </div>
  {% endif %}

  {%- capture pack_1 -%}
    {%- if section.settings.product_1 != blank and section.settings.product_1.featured_image -%}
      {%- assign p = section.settings.product_1 -%}
      <figure class="pzhb-pack">
        <a href="{{ p.url }}">
          {%- if section.settings.product_1_asset != blank -%}
            <img src="{{ section.settings.product_1_asset | asset_url }}" alt="{{ p.title | escape }}" loading="lazy" width="800" height="800">
          {%- else -%}
            {{ p.featured_image | image_url: width: 800 | image_tag: alt: p.title, loading: 'lazy', sizes: '(min-width: 750px) 300px, 150px', widths: '300, 500, 800' }}
          {%- endif -%}
        </a>
        {%- if section.settings.product_1_label != blank -%}<figcaption>{{ section.settings.product_1_label }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture pack_2 -%}
    {%- if section.settings.product_2 != blank and section.settings.product_2.featured_image -%}
      {%- assign p = section.settings.product_2 -%}
      <figure class="pzhb-pack">
        <a href="{{ p.url }}">
          {%- if section.settings.product_2_asset != blank -%}
            <img src="{{ section.settings.product_2_asset | asset_url }}" alt="{{ p.title | escape }}" loading="lazy" width="800" height="800">
          {%- else -%}
            {{ p.featured_image | image_url: width: 800 | image_tag: alt: p.title, loading: 'lazy', sizes: '(min-width: 750px) 300px, 150px', widths: '300, 500, 800' }}
          {%- endif -%}
        </a>
        {%- if section.settings.product_2_label != blank -%}<figcaption>{{ section.settings.product_2_label }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
  {%- endcapture -%}

  <div class="pzhb-inner{% if pack_count > 0 %} pzhb-inner--products{% if pack_count == 2 %} pzhb-inner--two{% else %} pzhb-inner--one{% endif %}{% endif %}">
    {% if pack_count > 0 %}
      <div class="pzhb-packs-mobile">{{ pack_1 }}{{ pack_2 }}</div>
      {% if pack_count == 2 %}<div class="pzhb-pack--desktop">{{ pack_1 }}</div>{% endif %}
    {% endif %}
    <div class="pzhb-copy">
      {% if section.settings.eyebrow != blank %}
        <span class="pzhb-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        {%- assign pz_heading_tag = section.settings.heading_tag | default: 'h1' -%}
        <{{ pz_heading_tag }} class="pzhb-heading">{{ section.settings.heading | newline_to_br }}</{{ pz_heading_tag }}>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="pzhb-points">
          {% for block in section.blocks %}
            {% if block.type == 'point' and block.settings.text != blank %}
              <li class="pzhb-point" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="pzhb-sub">{{ section.settings.subheading | newline_to_br }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank or section.settings.cta2_text != blank %}
        <div class="pzhb-ctas">
          {% if section.settings.cta_text != blank %}
            <a class="pzhb-cta button button--secondary" href="{{ section.settings.cta_url | default: '#pz-wholesale-application' }}">
              {{ section.settings.cta_text }}
            </a>
          {% endif %}
          {% if section.settings.cta2_text != blank %}
            <a class="pzhb-cta button button--secondary" href="{{ section.settings.cta2_url | default: '#' }}">
              {{ section.settings.cta2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    {% if pack_count == 2 %}
      <div class="pzhb-pack--desktop">{{ pack_2 }}</div>
    {% elsif pack_count == 1 %}
      <div class="pzhb-pack--desktop">{{ pack_1 }}{{ pack_2 }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PZ Hero Banner",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-wholesale-top" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wholesale" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Line breaks here are kept", "default": "Performance drinks made for pickleball players." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "info": "Use H1 once per page, on the first heading. Later banners on the same page should be H2.", "options": [{"value":"h1","label":"Main page heading (H1)"},{"value":"h2","label":"Section heading (H2)"}], "default": "h1" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Centre"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Start Application" },
    { "type": "text", "id": "cta_url", "label": "Button link", "info": "Defaults to the application form on this page", "default": "#pz-wholesale-application" },
    { "type": "text", "id": "cta2_text", "label": "Second button text", "info": "Optional, e.g. Shop RECOVER" },
    { "type": "url", "id": "cta2_url", "label": "Second button link" },
    { "type": "range", "id": "button_radius", "label": "Button radius (px)", "min": 0, "max": 60, "step": 2, "default": 60 },
    { "type": "header", "content": "Product packs", "info": "Shows each product's main image (the bag) beside the copy. With two, they sit either side." },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "product_1_label", "label": "Product 1 caption" },
    { "type": "text", "id": "product_1_asset", "label": "Product 1 cut-out asset", "info": "Optional transparent PNG in the theme assets, used instead of the product photo on dark backgrounds" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "product_2_label", "label": "Product 2 caption" },
    { "type": "text", "id": "product_2_asset", "label": "Product 2 cut-out asset", "info": "Optional transparent PNG in the theme assets, used instead of the product photo on dark backgrounds" },
    { "type": "range", "id": "product_image_width", "label": "Pack image max width (px)", "min": 160, "max": 420, "step": 10, "default": 300 },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Preferred \u2014 gives Shopify's responsive sizes. Falls back to the theme asset below." },
    { "type": "text", "id": "image_filename", "label": "Fallback image asset", "info": "Filename in the theme's assets folder" },
    { "type": "text", "id": "image_filename_sm", "label": "Fallback image asset (small)", "info": "Smaller copy of the same photo, served to phones" },
    { "type": "number", "id": "image_width", "label": "Fallback image width (px)", "info": "Intrinsic size of the asset, so the browser can reserve space" },
    { "type": "number", "id": "image_height", "label": "Fallback image height (px)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Describe the photo for screen readers", "default": "A player drinking 5 Point Zero between games at an indoor pickleball facility" },
    { "type": "range", "id": "min_height", "label": "Minimum height (svh)", "min": 40, "max": 95, "step": 5, "default": 80 },
    { "type": "range", "id": "copy_width", "label": "Copy column width (px)", "info": "How wide the headline is allowed to run on desktop", "min": 360, "max": 900, "step": 20, "default": 660 },
    { "type": "range", "id": "image_blur", "label": "Image blur (px)", "info": "Leave at 0 unless the photo is busy behind the copy \u2014 blur costs real detail", "min": 0, "max": 12, "step": 1, "default": 0 },
    { "type": "range", "id": "image_brightness", "label": "Image brightness (%)", "min": 40, "max": 130, "step": 5, "default": 95 },
    { "type": "range", "id": "scrim_strength", "label": "Scrim strength (%)", "info": "Darkens the side the copy sits on", "min": 20, "max": 95, "step": 5, "default": 75 },
    { "type": "range", "id": "focal_x", "label": "Image focal point X (%)", "min": 0, "max": 100, "step": 5, "default": 65 },
    { "type": "range", "id": "focal_y", "label": "Image focal point Y (%)", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#96FF00" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Headline point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "High Margins." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Hero Banner",
      "blocks": [
        { "type": "point", "settings": { "text": "High Margins." } },
        { "type": "point", "settings": { "text": "Low Minimums." } }
      ]
    }
  ]
}
{% endschema %}
