{% comment %}
  PZ Product Hero — swipeable image slider + thumbnails, AG1-style pack/variant
  picker with savings badges, trust list, and a sticky mobile add-to-cart bar.
  Fully color-customizable, touch-friendly slider on mobile and desktop.
{% endcomment %}
<section class="pz-hero pz-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  {% style %}
    .pz-hero-{{ section.id }} {
      --pz-accent: {{ section.settings.accent_color }};
      --pz-accent-text: {{ section.settings.accent_text_color }};
      --pz-ink: {{ section.settings.text_color }};
      --pz-heading: {{ section.settings.heading_color }};
      --pz-bg: {{ section.settings.background }};
      --pz-card-bg: {{ section.settings.card_background }};
      --pz-border: {{ section.settings.border_color }};
      background: var(--pz-bg);
      color: var(--pz-ink);
      padding: 32px 0 48px;
    }
    .pz-hero-{{ section.id }} .pz-hero-grid {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .pz-hero-{{ section.id }} .pz-hero-grid { grid-template-columns: 1fr; gap: 20px; padding: 0; }
    }

    /* Grid items default to min-width: auto, which lets a wide intrinsic
       image size expand the track and overflow the viewport. Force them to
       shrink to their track instead. */
    .pz-hero-{{ section.id }} .pz-gallery,
    .pz-hero-{{ section.id }} product-info {
      min-width: 0;
    }

    /* Slider */
    {% if section.settings.enable_sticky_gallery %}
      @media (min-width: 901px) {
        .pz-hero-{{ section.id }} .pz-gallery { position: sticky; top: 24px; }
      }
    {% endif %}
    .pz-hero-{{ section.id }} product-info { padding: 0 16px; }
    @media (min-width: 901px) {
      .pz-hero-{{ section.id }} product-info { padding: 0; }
    }
    .pz-hero-{{ section.id }} .pz-slider {
      position: relative;
      overflow: hidden;
      background: var(--pz-card-bg);
    }
    @media (min-width: 901px) {
      .pz-hero-{{ section.id }} .pz-slider { border-radius: 16px; }
    }
    .pz-hero-{{ section.id }} .pz-slides {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      aspect-ratio: 1 / 1;
    }
    .pz-hero-{{ section.id }} .pz-slides::-webkit-scrollbar { display: none; }
    .pz-hero-{{ section.id }} .pz-slide {
      flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always;
      width: 100%; height: 100%; position: relative;
    }
    .pz-hero-{{ section.id }} .pz-slide img,
    .pz-hero-{{ section.id }} .pz-slide video {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .pz-hero-{{ section.id }} .pz-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 40px; height: 40px; border-radius: 50%; border: none;
      background: rgba(255,255,255,.9); color: var(--pz-ink);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; z-index: 2; box-shadow: 0 2px 8px rgba(0,0,0,.15);
    }
    .pz-hero-{{ section.id }} .pz-arrow-prev { left: 12px; }
    .pz-hero-{{ section.id }} .pz-arrow-next { right: 12px; }
    .pz-hero-{{ section.id }} .pz-arrow:disabled { opacity: 0; pointer-events: none; }
    .pz-hero-{{ section.id }} .pz-dots {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 6px; z-index: 2;
    }
    .pz-hero-{{ section.id }} .pz-dot {
      width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.6);
      border: none; padding: 0; cursor: pointer;
    }
    .pz-hero-{{ section.id }} .pz-dot.is-active { background: #fff; width: 16px; border-radius: 4px; }

    .pz-hero-{{ section.id }} .pz-gallery-thumbs {
      display: flex; gap: 8px; margin-top: 12px; overflow-x: auto;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 2px;
      padding-left: 16px; padding-right: 16px;
    }
    @media (min-width: 901px) {
      .pz-hero-{{ section.id }} .pz-gallery-thumbs { padding-left: 0; padding-right: 0; }
    }
    .pz-hero-{{ section.id }} .pz-gallery-thumbs::-webkit-scrollbar { display: none; }
    .pz-hero-{{ section.id }} .pz-gallery-thumbs button {
      flex: 0 0 64px; width: 64px; height: 64px; border-radius: 8px; overflow: hidden;
      border: 2px solid transparent; padding: 0; cursor: pointer; background: var(--pz-card-bg);
    }
    .pz-hero-{{ section.id }} .pz-gallery-thumbs button.is-active { border-color: var(--pz-accent); }
    .pz-hero-{{ section.id }} .pz-gallery-thumbs img { width: 100%; height: 100%; object-fit: cover; display: block; }
    @media (min-width: 700px) {
      .pz-hero-{{ section.id }} .pz-arrow { width: 44px; height: 44px; }
      .pz-hero-{{ section.id }} .pz-dots { display: none; }
    }

    /* Award badge — dark pill with accent text rather than a solid neon
       fill. Keeps neon green as an accent instead of a large color mass,
       and reads more like an award mark. */
    .pz-hero-{{ section.id }} .pz-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: {{ section.settings.badge_bg_color }}; color: {{ section.settings.badge_text_color }};
      font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
      padding: 7px 13px; border-radius: 4px; margin-bottom: 14px;
      line-height: 1.2;
    }
    .pz-hero-{{ section.id }} h1 {
      font-size: clamp(32px, 4vw, 46px); line-height: 1.02; margin: 0 0 10px; font-weight: 800;
      color: var(--pz-heading); letter-spacing: -0.015em;
    }
    .pz-hero-{{ section.id }} .pz-subhead {
      font-size: 16px; line-height: 1.55; margin: 0 0 16px; max-width: 46ch;
      color: var(--pz-ink); opacity: .7;
    }
    .pz-hero-{{ section.id }} .pz-reviews-line {
      display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 22px; flex-wrap: wrap;
      padding-bottom: 18px; border-bottom: 1px solid var(--pz-border);
    }
    .pz-hero-{{ section.id }} .pz-stars { color: {{ section.settings.star_color }}; letter-spacing: 1px; }
    .pz-hero-{{ section.id }} .pz-reviews-count { font-weight: 800; }
    .pz-hero-{{ section.id }} .pz-reviews-text { opacity: .7; }

    /* Native price / variant-picker / buy-buttons — these reuse the theme's
       own components so they inherit its button, pill, and swatch styling
       (colors above only theme the surrounding hero, not these components). */
    .pz-hero-{{ section.id }} product-info { display: block; }
    .pz-hero-{{ section.id }} #price-{{ section.id }} { margin-bottom: 16px; font-size: 18px; }
    .pz-hero-{{ section.id }} .product-form__input { margin-bottom: 16px; }
    .pz-hero-{{ section.id }} .product-form__buttons { margin-bottom: 12px; }

    /* Buy button — fully overridden per-section rather than relying on the
       theme's global button settings, so this section's button can have its
       own color/shape/size regardless of the rest of the theme. */
    .pz-hero-{{ section.id }} .product-form__submit {
      min-height: 44px;
      width: 100%;
      background: {{ section.settings.atc_bg_color }} !important;
      color: {{ section.settings.atc_text_color }} !important;
      border-color: {{ section.settings.atc_bg_color }} !important;
      border-radius: {{ section.settings.atc_border_radius }}px !important;
      {% case section.settings.atc_size %}
        {% when 'small' %}
          padding-top: 10px !important; padding-bottom: 10px !important; font-size: 14px !important;
        {% when 'large' %}
          padding-top: 20px !important; padding-bottom: 20px !important; font-size: 18px !important;
        {% else %}
          padding-top: 15px !important; padding-bottom: 15px !important; font-size: 16px !important;
      {% endcase %}
      font-weight: 800 !important;
    }
    /* Dawn's buy-buttons markup includes a trailing arrow icon inside the
       button's text span — hide it for a cleaner, text-only button. */
    .pz-hero-{{ section.id }} .product-form__submit > span > svg {
      display: none;
    }
    .pz-hero-{{ section.id }} .product-form__submit .pz-btn-price {
      font-weight: 700;
      opacity: .9;
    }
    .pz-hero-{{ section.id }} .product-form__submit .pz-btn-price::before {
      content: '·';
      margin: 0 6px;
    }

    .pz-hero-{{ section.id }} .pz-atc {
      width: 100%; padding: 16px; border-radius: 999px; border: none;
      background: var(--pz-accent); color: var(--pz-accent-text); font-weight: 800; font-size: 16px;
      letter-spacing: .02em; cursor: pointer; margin-bottom: 12px; min-height: 44px;
    }
    .pz-hero-{{ section.id }} .pz-atc:disabled { opacity: .5; cursor: not-allowed; }
    .pz-hero-{{ section.id }} .pz-guarantee {
      display: flex; align-items: center; gap: 8px; font-size: 13px; opacity: .8; justify-content: center; margin-bottom: 20px;
    }
    .pz-hero-{{ section.id }} .pz-trust-list {
      list-style: none; margin: 16px 0 0; padding: 0;
      display: grid; gap: 8px;
    }
    /* Neutral surface so the neon green stays on the CTA and small icons
       rather than tinting every row in the buy box. */
    .pz-hero-{{ section.id }} .pz-trust-row {
      display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600;
      background: {{ section.settings.trust_bg_color }};
      border-radius: 10px; padding: 11px 14px;
    }
    .pz-hero-{{ section.id }} .pz-trust-icon {
      flex: none; width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      background: var(--pz-accent); color: var(--pz-accent-text);
    }
    .pz-hero-{{ section.id }} .pz-trust-highlight {
      display: inline-block; background: var(--pz-accent); color: var(--pz-accent-text);
      font-weight: 800; padding: 2px 8px; border-radius: 5px; margin-left: 4px;
    }

    /* Pack / quantity bundle selector */
    .pz-hero-{{ section.id }} .pz-pack-tiers {
      display: grid; gap: 10px; margin-bottom: 18px;
    }
    .pz-hero-{{ section.id }} .pz-pack-tier {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      border: 2px solid var(--pz-border); border-radius: 12px; padding: 14px 16px;
      cursor: pointer; position: relative; transition: border-color .15s ease;
      background: var(--pz-card-bg); min-height: 44px;
    }
    .pz-hero-{{ section.id }} .pz-pack-tier:hover { border-color: var(--pz-accent); }
    .pz-hero-{{ section.id }} .pz-pack-tier.is-selected {
      border-color: var(--pz-accent); box-shadow: 0 0 0 1px var(--pz-accent);
    }
    .pz-hero-{{ section.id }} .pz-pack-tier input { position: absolute; opacity: 0; pointer-events: none; }
    .pz-hero-{{ section.id }} .pz-pack-badge {
      position: absolute; top: -10px; left: 16px; background: var(--pz-accent); color: var(--pz-accent-text);
      font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
      padding: 3px 8px; border-radius: 999px;
    }
    .pz-hero-{{ section.id }} .pz-pack-label { font-weight: 700; font-size: 15px; }
    .pz-hero-{{ section.id }} .pz-pack-sub { font-size: 13px; opacity: .7; margin-top: 2px; }
    .pz-hero-{{ section.id }} .pz-pack-price-cluster { text-align: right; flex: none; }
    .pz-hero-{{ section.id }} .pz-pack-price-row { display: flex; align-items: baseline; gap: 6px; justify-content: flex-end; }
    .pz-hero-{{ section.id }} .pz-pack-compare-at { text-decoration: line-through; opacity: .5; font-size: 13px; }
    .pz-hero-{{ section.id }} .pz-pack-now { font-weight: 800; font-size: 18px; }
    .pz-hero-{{ section.id }} .pz-pack-tags { display: flex; gap: 6px; justify-content: flex-end; margin-top: 4px; flex-wrap: wrap; }
    .pz-hero-{{ section.id }} .pz-pack-tag {
      font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px; white-space: nowrap;
    }
    /* Neon green as TEXT on a light card is ~1.3:1 contrast (unreadable).
       Use it on a dark pill instead, where it reads ~15:1. */
    .pz-hero-{{ section.id }} .pz-pack-tag--save {
      background: {{ section.settings.savings_bg_color }}; color: {{ section.settings.savings_text_color }};
      letter-spacing: .02em;
    }
    .pz-hero-{{ section.id }} .pz-pack-tag--ship {
      background: transparent; color: var(--pz-ink); opacity: .75;
      border: 1px solid var(--pz-border);
    }

    .pz-hero-{{ section.id }} .pz-sticky-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      background: var(--pz-card-bg); border-top: 1px solid var(--pz-border);
      padding: 10px 16px; display: none; align-items: center; justify-content: space-between; gap: 12px;
      box-shadow: 0 -4px 16px rgba(0,0,0,.06);
      padding-bottom: max(10px, env(safe-area-inset-bottom));
    }
    .pz-hero-{{ section.id }} .pz-sticky-bar.is-visible { display: flex; }
    .pz-hero-{{ section.id }} .pz-sticky-bar .pz-atc { margin: 0; width: auto; padding: 12px 24px; font-size: 14px; }
    .pz-hero-{{ section.id }} .pz-sticky-title { font-size: 14px; font-weight: 700; }
    .pz-hero-{{ section.id }} .pz-sticky-price { font-size: 13px; opacity: .7; }
  {% endstyle %}

  <div class="pz-hero-grid">
    <div class="pz-gallery">
      <div class="pz-slider">
        <div class="pz-slides" id="pz-slides-{{ section.id }}">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              {% liquid
                assign img_loading = 'lazy'
                if forloop.first
                  assign img_loading = 'eager'
                endif
              %}
              <div class="pz-slide" data-index="{{ forloop.index0 }}">
                {% case media.media_type %}
                  {% when 'video' %}
                    {{ media | video_tag: image_size: '1200x', controls: true }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag }}
                  {% else %}
                    {{ media | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(max-width: 900px) 100vw, 600px', alt: media.alt, loading: img_loading }}
                {% endcase %}
              </div>
            {% endfor %}
          {% else %}
            <div class="pz-slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {% endif %}
        </div>
        {% if product.media.size > 1 %}
          <button type="button" class="pz-arrow pz-arrow-prev" id="pz-prev-{{ section.id }}" aria-label="Previous image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="pz-arrow pz-arrow-next" id="pz-next-{{ section.id }}" aria-label="Next image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
          </button>
          <div class="pz-dots" id="pz-dots-{{ section.id }}">
            {% for media in product.media %}
              <button type="button" class="pz-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% if product.media.size > 1 %}
        <div class="pz-gallery-thumbs" id="pz-gallery-thumbs-{{ section.id }}">
          {% for media in product.media %}
            <button type="button" class="pz-thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: alt: media.alt, loading: 'lazy' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {%- liquid
      assign product_form_id = 'product-form-' | append: section.id
      assign variant_picker_block = nil
      assign buy_buttons_block = nil
      for block in section.blocks
        case block.type
          when 'variant_picker'
            assign variant_picker_block = block
          when 'buy_buttons'
            assign buy_buttons_block = block
        endcase
      endfor
    -%}
    <product-info
      class="pz-buybox"
      id="ProductInfo-{{ section.id }}"
      data-section="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-update-url="false"
      data-url="{{ product.url }}"
    >
      {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}

      {% if section.settings.badge_text != blank %}
        <span class="pz-badge">{{ section.settings.badge_text }}</span>
      {% endif %}
      <h1>{{ product.title }}</h1>
      {% if section.settings.subheadline != blank %}
        <p class="pz-subhead">{{ section.settings.subheadline }}</p>
      {% endif %}
      {% if section.settings.show_reviews_line %}
        <div class="pz-reviews-line">
          <span class="pz-stars" aria-hidden="true">★★★★★</span>
          {% if section.settings.reviews_count != blank %}
            <span class="pz-reviews-count">{{ section.settings.reviews_count }}</span>
          {% endif %}
          <span class="pz-reviews-text">{{ section.settings.reviews_line_text }}</span>
        </div>
      {% endif %}

      {%- assign pack_tiers = section.blocks | where: 'type', 'pack_tier' -%}
      {% unless section.settings.show_pack_selector and pack_tiers.size > 0 %}
        <div id="price-{{ section.id }}" role="status">
          {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
        </div>
      {% endunless %}

      {% if section.settings.show_variant_picker %}
        {% render 'product-variant-picker', product: product, block: variant_picker_block, product_form_id: product_form_id %}
      {% endif %}

      {% if section.settings.show_pack_selector and pack_tiers.size > 0 %}
        <div class="pz-pack-tiers" role="radiogroup" aria-label="Pack size">
          {% for block in pack_tiers %}
            {%- liquid
              assign matched_variant = product.variants | where: 'title', block.settings.variant_title | first
              unless matched_variant
                assign matched_variant = product.selected_or_first_available_variant
              endunless
              assign tier_price = matched_variant.price
              assign tier_compare = 0
              if matched_variant.compare_at_price > tier_price
                assign tier_compare = matched_variant.compare_at_price
              endif
              assign tier_savings = 0
              if tier_compare > tier_price
                assign tier_savings = tier_compare | minus: tier_price
              endif
            -%}
            <label
              class="pz-pack-tier {% if forloop.first %}is-selected{% endif %}"
              data-variant-id="{{ matched_variant.id }}"
              data-price="{{ tier_price }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.badge_text != blank %}
                <span class="pz-pack-badge">{{ block.settings.badge_text }}</span>
              {% endif %}
              <input type="radio" name="pz-pack-radio-{{ section.id }}" value="{{ matched_variant.id }}" {% if forloop.first %}checked{% endif %} {% unless matched_variant.available %}disabled{% endunless %}>
              <span>
                <span class="pz-pack-label">{{ block.settings.label }}</span>
                {% if block.settings.sublabel != blank %}
                  <span class="pz-pack-sub">{{ block.settings.sublabel }}</span>
                {% endif %}
              </span>
              <span class="pz-pack-price-cluster">
                <span class="pz-pack-price-row">
                  {% if tier_compare > tier_price %}
                    <span class="pz-pack-compare-at">{{ tier_compare | money }}</span>
                  {% endif %}
                  <span class="pz-pack-now">{{ tier_price | money }}</span>
                </span>
                <span class="pz-pack-tags">
                  {% if tier_savings > 0 %}
                    <span class="pz-pack-tag pz-pack-tag--save">Save {{ tier_savings | money }}</span>
                  {% endif %}
                  {% if block.settings.show_free_shipping %}
                    <span class="pz-pack-tag pz-pack-tag--ship">Free S&amp;H</span>
                  {% endif %}
                </span>
              </span>
            </label>
          {% endfor %}
        </div>
      {% endif %}

      {% render 'buy-buttons',
        block: buy_buttons_block,
        product: product,
        product_form_id: product_form_id,
        section_id: section.id,
        show_pickup_availability: false
      %}

      {% if section.settings.guarantee_text != blank %}
        <div class="pz-guarantee">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
          {{ section.settings.guarantee_text }}
        </div>
      {% endif %}

      {% assign trust_items = section.blocks | where: 'type', 'trust_item' %}
      {% if trust_items.size > 0 %}
        <ul class="pz-trust-list">
          {% for block in trust_items %}
            <li class="pz-trust-row" {{ block.shopify_attributes }}>
              <span class="pz-trust-icon">
                {% case block.settings.icon %}
                  {% when 'truck' %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17V7a1 1 0 0 1 1-1h9v11"/><path d="M13 10h4l3 3v4h-2"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/></svg>
                  {% when 'pause' %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                  {% when 'shield' %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
                  {% else %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                {% endcase %}
              </span>
              <span>
                {{ block.settings.text }}
                {% if block.settings.highlight != blank %}
                  <span class="pz-trust-highlight">{{ block.settings.highlight }}</span>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </product-info>
  </div>

  <div class="pz-sticky-bar" id="pz-sticky-bar-{{ section.id }}">
    <div>
      <div class="pz-sticky-title">{{ product.title }}</div>
      <div class="pz-sticky-price" id="pz-sticky-price-{{ section.id }}">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
    <button
      type="submit"
      form="{{ product_form_id }}"
      class="pz-atc"
      id="pz-sticky-atc-{{ section.id }}"
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {% if product.selected_or_first_available_variant.available %}
        {{ section.settings.atc_label | default: 'Add to Cart' }}
      {% else %}
        Sold Out
      {% endif %}
    </button>
  </div>
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

<script>
(function () {
  var root = document.querySelector('.pz-hero-{{ section.id }}');
  if (!root) return;

  /* Keep the sticky mobile add-to-cart bar in sync with the native
     product-info variant swap (price + availability), which fires
     PUB_SUB_EVENTS.variantChange after it updates #price-{{ section.id }}. */
  if (window.subscribe && window.PUB_SUB_EVENTS) {
    subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
      if (!event.data || event.data.sectionId !== '{{ section.id }}') return;
      var variant = event.data.variant;
      var stickyPrice = root.querySelector('#pz-sticky-price-{{ section.id }}');
      var stickyAtc = root.querySelector('#pz-sticky-atc-{{ section.id }}');
      var priceWrap = document.getElementById('price-{{ section.id }}');
      if (stickyPrice && priceWrap) {
        stickyPrice.textContent = priceWrap.textContent.replace(/\s+/g, ' ').trim();
      }
      if (stickyAtc) {
        stickyAtc.disabled = !(variant && variant.available);
        stickyAtc.textContent = variant && variant.available
          ? '{{ section.settings.atc_label | default: "Add to Cart" }}'
          : 'Sold Out';
      }
      if (!packTiers.length && variant) updateButtonPrice(variant.price);
    });
  }

  /* Pack selector — each tier maps to a real variant, not a fake quantity */
  var showPriceInButton = {{ section.settings.show_price_in_button | default: false | json }};
  var atcButton = document.getElementById('ProductSubmitButton-{{ section.id }}');
  var packTiers = root.querySelectorAll('.pz-pack-tier');
  var productForm = document.getElementById('{{ product_form_id }}');
  var variantIdInput = productForm ? productForm.querySelector('.product-variant-id') : null;

  function pzFormatMoney(cents) {
    try {
      return new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
        style: 'currency',
        currency: '{{ shop.currency }}'
      }).format(cents / 100);
    } catch (e) {
      return '$' + (cents / 100).toFixed(2);
    }
  }

  function updateButtonPrice(cents) {
    if (!showPriceInButton || !atcButton || typeof cents !== 'number') return;
    var span = atcButton.querySelector('span');
    if (!span) return;
    var priceEl = span.querySelector('.pz-btn-price');
    if (!priceEl) {
      priceEl = document.createElement('span');
      priceEl.className = 'pz-btn-price';
      span.appendChild(priceEl);
    }
    priceEl.textContent = pzFormatMoney(cents);
  }

  function selectTier(tier) {
    var radio = tier.querySelector('input[type="radio"]');
    if (radio && radio.disabled) return;
    packTiers.forEach(function (t) { t.classList.remove('is-selected'); });
    tier.classList.add('is-selected');
    if (radio) radio.checked = true;
    if (variantIdInput) {
      variantIdInput.value = tier.dataset.variantId;
      variantIdInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
    if (atcButton) {
      var soldOut = !!(radio && radio.disabled);
      atcButton.setAttribute('aria-disabled', soldOut);
      atcButton.disabled = soldOut;
    }
    updateButtonPrice(+tier.dataset.price);
  }

  if (packTiers.length) {
    packTiers.forEach(function (tier) {
      tier.addEventListener('click', function () { selectTier(tier); });
    });
    var initialTier = root.querySelector('.pz-pack-tier.is-selected') || packTiers[0];
    if (initialTier) updateButtonPrice(+initialTier.dataset.price);
  } else {
    updateButtonPrice({{ product.selected_or_first_available_variant.price | default: 0 }});
  }

  /* Slider */
  var slides = root.querySelector('#pz-slides-{{ section.id }}');
  var thumbs = root.querySelectorAll('#pz-gallery-thumbs-{{ section.id }} .pz-thumb');
  var dots = root.querySelectorAll('#pz-dots-{{ section.id }} .pz-dot');
  var prevBtn = root.querySelector('#pz-prev-{{ section.id }}');
  var nextBtn = root.querySelector('#pz-next-{{ section.id }}');

  if (slides) {
    var slideEls = Array.prototype.slice.call(slides.querySelectorAll('.pz-slide'));

    function goTo(index) {
      index = Math.max(0, Math.min(index, slideEls.length - 1));
      slides.scrollTo({ left: slideEls[index].offsetLeft, behavior: 'smooth' });
    }

    function setActive(index) {
      thumbs.forEach(function (t) { t.classList.toggle('is-active', +t.dataset.index === index); });
      dots.forEach(function (d) { d.classList.toggle('is-active', +d.dataset.index === index); });
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === slideEls.length - 1;
    }

    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { goTo(+t.dataset.index); });
    });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(+d.dataset.index); });
    });
    if (prevBtn) prevBtn.addEventListener('click', function () {
      goTo(Math.round(slides.scrollLeft / slides.clientWidth) - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', function () {
      goTo(Math.round(slides.scrollLeft / slides.clientWidth) + 1);
    });

    if ('IntersectionObserver' in window) {
      var slideObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            setActive(+entry.target.dataset.index);
          }
        });
      }, { root: slides, threshold: [0.6] });
      slideEls.forEach(function (s) { slideObserver.observe(s); });
    }

    setActive(0);
  }

  var heroAtc = root.querySelector('#ProductSubmitButton-{{ section.id }}');
  var stickyBar = root.querySelector('#pz-sticky-bar-{{ section.id }}');
  if (heroAtc && stickyBar && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        stickyBar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { threshold: 0 });
    observer.observe(heroAtc);
  }
})();
</script>

{% schema %}
{
  "name": "PZ Product Hero",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "NEW: Best Sports Performance Drink" },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Hydration. Endurance. Anti-cramping. Focus. Everything you need, nothing you don't." },
    { "type": "checkbox", "id": "show_reviews_line", "label": "Show reviews line", "default": true },
    { "type": "text", "id": "reviews_count", "label": "Review count", "info": "Optional. Only enter a real number from your reviews app — leave blank to hide." },
    { "type": "text", "id": "reviews_line_text", "label": "Reviews line text", "default": "Loved by pickleball players nationwide" },
    { "type": "text", "id": "atc_label", "label": "Sticky bar add to cart label", "info": "Only used by the mobile sticky bar; the main button uses the theme's own 'Add to cart' translation", "default": "Add to Cart" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "100% money back guarantee" },
    { "type": "checkbox", "id": "enable_sticky_gallery", "label": "Sticky image on scroll (desktop)", "default": true },
    { "type": "checkbox", "id": "show_variant_picker", "label": "Show variant picker", "info": "Hides the native option picker (e.g. flavor/size). Turn off for single-variant products or if the pack selector below covers it.", "default": true },
    {
      "type": "header",
      "content": "Pack / quantity selector"
    },
    { "type": "checkbox", "id": "show_pack_selector", "label": "Show pack selector", "info": "Lets customers pick a quantity bundle (e.g. 1 bag vs. 2 bags) without discovering it via the quantity field. Add 'Pack option' blocks below.", "default": true },
    {
      "type": "header",
      "content": "Add to cart button"
    },
    { "type": "checkbox", "id": "show_price_in_button", "label": "Show price in button", "info": "e.g. \"Add to Cart · $49.00\", updates live with the selected pack", "default": true },
    { "type": "color", "id": "atc_bg_color", "label": "Background color", "default": "#96FF00" },
    { "type": "color", "id": "atc_text_color", "label": "Text color", "default": "#000000" },
    { "type": "range", "id": "atc_border_radius", "label": "Corner roundedness (px)", "info": "CSS caps this at half the button's height, so a high value still gives a full pill shape", "min": 0, "max": 60, "step": 2, "default": 60 },
    {
      "type": "select",
      "id": "atc_size",
      "label": "Button size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Neon green reads ~1.3:1 on white — keep it as a background with dark text, not as text on light surfaces", "default": "#96FF00" },
    { "type": "color", "id": "accent_text_color", "label": "Text on accent color", "info": "Text/icon color shown on top of the accent color above", "default": "#000000" },
    { "type": "color", "id": "badge_bg_color", "label": "Award badge background", "default": "#111111" },
    { "type": "color", "id": "badge_text_color", "label": "Award badge text", "default": "#96FF00" },
    { "type": "color", "id": "savings_bg_color", "label": "Savings tag background", "default": "#111111" },
    { "type": "color", "id": "savings_text_color", "label": "Savings tag text", "default": "#96FF00" },
    { "type": "color", "id": "trust_bg_color", "label": "Trust row background", "default": "#f6f6f6" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "star_color", "label": "Star rating color", "default": "#f5a623" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card / option background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#e3e3e3" }
  ],
  "blocks": [
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker type",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button", "label": "Pills / cards" }
          ],
          "default": "button"
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "label": "Swatch shape",
          "info": "Only applies to options with swatches configured (e.g. Flavor). Set to None to always use pills/cards.",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "circle"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "info": "Shop Pay, Apple Pay, etc., rendered by Shopify", "default": true },
        { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Show gift card recipient form", "default": false }
      ]
    },
    {
      "type": "pack_tier",
      "name": "Pack option",
      "settings": [
        { "type": "text", "id": "variant_title", "label": "Variant title", "info": "Must exactly match a real variant's title in Product > Variants, e.g. \"2 PERFORM - 60 Servings\". Price, compare-at price, and availability are pulled live from that variant." },
        { "type": "text", "id": "label", "label": "Label", "default": "1 Bag" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "30 servings" },
        { "type": "text", "id": "badge_text", "label": "Corner badge text", "info": "e.g. Best Value — leave blank to hide" },
        { "type": "checkbox", "id": "show_free_shipping", "label": "Show \"Free S&H\" tag", "default": false }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust list item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "pause", "label": "Pause (subscription)" },
            { "value": "shield", "label": "Shield (guarantee)" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping always" },
        { "type": "text", "id": "highlight", "label": "Highlighted phrase (optional)", "info": "Shown in a pill after the text, e.g. a delivery date" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Product Hero",
      "blocks": [
        { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        { "type": "pack_tier", "settings": { "variant_title": "1 PERFORM -  30 Servings", "label": "1 Bag", "sublabel": "30 servings" } },
        { "type": "pack_tier", "settings": { "variant_title": "2 PERFORM - 60 Servings", "label": "2 Bags", "sublabel": "60 servings", "badge_text": "Best Value", "show_free_shipping": true } },
        { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true } },
        { "type": "trust_item", "settings": { "icon": "truck", "text": "Free shipping on subscriptions" } },
        { "type": "trust_item", "settings": { "icon": "pause", "text": "Pause or cancel anytime" } },
        { "type": "trust_item", "settings": { "icon": "shield", "text": "100% money back guarantee" } }
      ]
    }
  ]
}
{% endschema %}
