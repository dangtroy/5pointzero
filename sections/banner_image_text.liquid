 

 
 {%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }






   
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">

  <div class="section-{{ section.id }}-padding">
      <div class="banner_image_cover">
     <div class="banner_image_item">
         {% if section.settings.img != blank %} <img  src="{{ section.settings.img | img_url:"master" }}" class="{% if section.settings.img2 != blank %}desktop-image{% endif %}">{% endif %}
          {% if section.settings.img2 != blank %} <img  src="{{ section.settings.img2 | img_url:"master" }}" class="mobile-image">{% endif %}
        </div>
     <div class="banner_image_inner">
    <div class="page-width">
     
        <div class="banner_text">
          <div class="banner_text_item">
            {% render 'review_star' %}
            {% if section.settings.headings != blank %} <h2 class="rich-text__heading rte inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                {{ section.settings.headings }}                         
              </h2>{% endif %}
            {% if section.settings.content != blank %}<div class="content">{{ section.settings.content }}</div>{% endif %} 
            <div class="banner_btn">
               {%- if section.settings.button_label != blank -%}
                  <a
                    {% if section.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ section.settings.link }}"
                    {% endif %}
                    class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} {% if section.settings.button_green %}button_arrow_green{% endif %}"
                  >
                    {{- section.settings.button_label | escape -}} <svg xmlns="http://www.w3.org/2000/svg" width="53" height="12" viewBox="0 0 53 12" fill="none">
<path d="M1.57617 5.39648C1.16196 5.39648 0.826172 5.73227 0.826172 6.14648C0.826172 6.5607 1.16196 6.89648 1.57617 6.89648V5.39648ZM52.1065 6.67681C52.3994 6.38392 52.3994 5.90905 52.1065 5.61615L47.3335 0.843184C47.0406 0.55029 46.5658 0.55029 46.2729 0.843184C45.98 1.13608 45.98 1.61095 46.2729 1.90384L50.5155 6.14648L46.2729 10.3891C45.98 10.682 45.98 11.1569 46.2729 11.4498C46.5658 11.7427 47.0406 11.7427 47.3335 11.4498L52.1065 6.67681ZM1.57617 6.89648H51.5762V5.39648H1.57617V6.89648Z" fill="black"/>
</svg>
                  </a>
                {%- endif -%}
