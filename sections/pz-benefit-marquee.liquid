{% comment %}
  PZ Benefit Marquee — SULT/AG1-style infinite scrolling ticker of icon +
  text pairs (e.g. "⚡ HYDRATION • 🔋 ENERGY • ..."). Pure CSS animation,
  duplicated content for a seamless loop, pauses on hover/tap.
{% endcomment %}
<section class="pz-marquee pz-marquee-{{ section.id }}">
  {% style %}
    .pz-marquee-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: {{ section.settings.padding_y }}px 0;
      overflow: hidden;
      border-top: 1px solid {{ section.settings.border_color }};
      border-bottom: 1px solid {{ section.settings.border_color }};
    }
    .pz-marquee-{{ section.id }} .pz-marquee-track {
      display: flex;
      width: max-content;
      animation: pz-marquee-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    }
    .pz-marquee-{{ section.id }}:hover .pz-marquee-track,
    .pz-marquee-{{ section.id }} .pz-marquee-track:active {
      animation-play-state: paused;
    }
    @keyframes pz-marquee-scroll-{{ section.id }} {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .pz-marquee-{{ section.id }} .pz-marquee-group {
      display: flex; align-items: center; flex: none;
    }
    .pz-marquee-{{ section.id }} .pz-marquee-item {
      display: flex; align-items: center; gap: {{ section.settings.icon_gap }}px; flex: none;
      padding: 0 {{ section.settings.item_spacing }}px; white-space: nowrap;
      font-size: {{ section.settings.font_size }}px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
    }
    .pz-marquee-{{ section.id }} .pz-marquee-item svg {
      flex: none; color: var(--pz-marquee-accent, {{ section.settings.icon_color }});
      width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;
    }
    .pz-marquee-{{ section.id }} .pz-marquee-item img {
      flex: none; width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px; object-fit: contain;
    }
    .pz-marquee-{{ section.id }} .pz-marquee-dot {
      width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .4; flex: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .pz-marquee-{{ section.id }} .pz-marquee-track { animation: none; }
    }
  {% endstyle %}

  {%- assign items = section.blocks | where: 'type', 'item' -%}
  {% if items.size > 0 %}
    <div class="pz-marquee-track">
      {% for i in (1..2) %}
        <div class="pz-marquee-group" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {% for block in items %}
            <span class="pz-marquee-item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {% case block.settings.icon %}
                {% when 'droplet' %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2s7 8.5 7 13a7 7 0 1 1-14 0c0-4.5 7-13 7-13Z"/></svg>
                {% when 'bolt' %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 11-14h-7l0-6Z"/></svg>
                {% when 'shield' %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/></svg>
                {% when 'target' %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
                {% when 'check' %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
                {% when 'image' %}
                  {% if block.settings.custom_icon %}
                    {{ block.settings.custom_icon | image_url: width: 40 | image_tag: alt: block.settings.label }}
                  {% endif %}
              {% endcase %}
              {{ block.settings.label }}
              <span class="pz-marquee-dot" aria-hidden="true"></span>
            </span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "PZ Benefit Marquee",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 5, "max": 60, "step": 1, "default": 22 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (px)", "min": 0, "max": 60, "step": 2, "default": 14 },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "font_size", "label": "Text size (px)", "min": 11, "max": 40, "step": 1, "default": 15 },
    { "type": "range", "id": "icon_size", "label": "Icon size (px)", "min": 12, "max": 56, "step": 2, "default": 18 },
    { "type": "range", "id": "icon_gap", "label": "Gap between icon and text (px)", "min": 0, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "item_spacing", "label": "Space between items (px)", "min": 8, "max": 80, "step": 2, "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#96FF00" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#141414" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet (hydration)" },
            { "value": "bolt", "label": "Bolt (energy)" },
            { "value": "shield", "label": "Shield (endurance)" },
            { "value": "target", "label": "Target (focus)" },
            { "value": "check", "label": "Checkmark" },
            { "value": "image", "label": "Custom image" },
            { "value": "none", "label": "None" }
          ],
          "default": "bolt"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image", "info": "Only used when Icon is set to Custom image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Hydration" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Benefit Marquee",
      "blocks": [
        { "type": "item", "settings": { "icon": "droplet", "label": "Hydration" } },
        { "type": "item", "settings": { "icon": "bolt", "label": "Energy" } },
        { "type": "item", "settings": { "icon": "shield", "label": "Endurance" } },
        { "type": "item", "settings": { "icon": "target", "label": "Focus" } },
        { "type": "item", "settings": { "icon": "check", "label": "Anti-Cramping" } },
        { "type": "item", "settings": { "icon": "check", "label": "Zero Artificial Ingredients" } }
      ]
    }
  ]
}
{% endschema %}
