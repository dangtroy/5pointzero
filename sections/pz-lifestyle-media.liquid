{% comment %}
  PZ Lifestyle Media — flexible image/video grid for lifestyle photography or
  clips (e.g. players on court). Each block can be an image OR a self-hosted
  video (uploaded via Shopify Files), with an optional caption overlay.
  Mobile: grid always collapses to a single column.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-lifestyle pz-lifestyle-{{ section.id }}">
  {% style %}
    .pz-lifestyle-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
      scroll-margin-top: 80px;
    }
    .pz-lifestyle-{{ section.id }} .pz-lifestyle-head {
      max-width: 1280px; margin: 0 auto 32px; text-align: center;
    }
    .pz-lifestyle-{{ section.id }} h2 {
      font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px;
      color: {{ section.settings.heading_color }};
    }
    .pz-lifestyle-{{ section.id }} .pz-lifestyle-sub { opacity: .75; max-width: 60ch; margin: 0 auto; }
    .pz-lifestyle-{{ section.id }} .pz-lifestyle-grid {
      max-width: 1280px; margin: 0 auto;
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: {{ section.settings.gap }}px;
    }
    @media (max-width: 900px) {
      .pz-lifestyle-{{ section.id }} .pz-lifestyle-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .pz-lifestyle-{{ section.id }} .pz-lifestyle-grid { grid-template-columns: 1fr; }
    }
    .pz-lifestyle-{{ section.id }} .pz-media-item {
      position: relative; overflow: hidden; border-radius: {{ section.settings.corner_radius }}px;
      background: #eee;
    }
    .pz-lifestyle-{{ section.id }} .pz-media-item.pz-ratio-square { aspect-ratio: 1 / 1; }
    .pz-lifestyle-{{ section.id }} .pz-media-item.pz-ratio-portrait { aspect-ratio: 4 / 5; }
    .pz-lifestyle-{{ section.id }} .pz-media-item.pz-ratio-landscape { aspect-ratio: 16 / 9; }
    .pz-lifestyle-{{ section.id }} .pz-media-item.pz-span-2 { grid-column: span 2; }
    @media (max-width: 600px) {
      .pz-lifestyle-{{ section.id }} .pz-media-item.pz-span-2 { grid-column: span 1; }
    }
    .pz-lifestyle-{{ section.id }} .pz-media-item img,
    .pz-lifestyle-{{ section.id }} .pz-media-item video {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .pz-lifestyle-{{ section.id }} .pz-media-caption {
      font-size: 13px; margin-top: 10px; text-align: center; opacity: .8;
    }
    .pz-lifestyle-{{ section.id }} .pz-media-caption-overlay {
      position: absolute; left: 0; right: 0; bottom: 0; margin: 0;
      padding: 24px 16px 16px;
      background: linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0));
      color: #fff; text-align: left; font-weight: 700; font-size: 15px;
    }
  {% endstyle %}

  <div class="pz-lifestyle-head">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-lifestyle-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="pz-lifestyle-grid">
    {% for block in section.blocks %}
      {% if block.type == 'media_item' %}
        <div class="pz-media-wrap" {{ block.shopify_attributes }}>
          <div class="pz-media-item pz-ratio-{{ block.settings.aspect_ratio }} {% if block.settings.wide %}pz-span-2{% endif %}">
            {% if block.settings.media_type == 'video' and block.settings.video != blank %}
              {{ block.settings.video | video_tag: image_size: '1000x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {% elsif block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1000 }} 1000w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
                alt="{{ block.settings.caption | default: 'Lifestyle image' | escape }}"
                loading="lazy" width="1000" height="1000">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
            {% if block.settings.caption != blank and block.settings.caption_style == 'overlay' %}
              <p class="pz-media-caption-overlay">{{ block.settings.caption }}</p>
            {% endif %}
          </div>
          {% if block.settings.caption != blank and block.settings.caption_style == 'below' %}
            <p class="pz-media-caption">{{ block.settings.caption }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "PZ Lifestyle Media",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-lifestyle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the Court" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "media_item",
      "name": "Image or video",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Used when media type is Image, and as a fallback if no video is set" },
        { "type": "video", "id": "video", "label": "Video", "info": "Uploaded via Shopify Files. Plays muted, looping, no controls." },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "options": [
            { "value": "square", "label": "Square (1:1)" },
            { "value": "portrait", "label": "Portrait (4:5)" },
            { "value": "landscape", "label": "Landscape (16:9)" }
          ],
          "default": "portrait"
        },
        { "type": "checkbox", "id": "wide", "label": "Span 2 columns on desktop/tablet", "default": false },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        {
          "type": "select",
          "id": "caption_style",
          "label": "Caption style",
          "options": [
            { "value": "overlay", "label": "Overlay on media" },
            { "value": "below", "label": "Below media" }
          ],
          "default": "overlay"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Lifestyle Media",
      "blocks": [
        { "type": "media_item", "settings": { "media_type": "image", "aspect_ratio": "portrait", "caption": "Game day ready" } },
        { "type": "media_item", "settings": { "media_type": "image", "aspect_ratio": "portrait", "caption": "Between points" } },
        { "type": "media_item", "settings": { "media_type": "image", "aspect_ratio": "portrait", "caption": "Post-match recovery" } }
      ]
    }
  ]
}
{% endschema %}
