{% comment %}
  Featured Product Section with Add to Cart Button
  Includes editable styles and custom text area.
{% endcomment %}

<section style="
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  border: 2px solid {{ section.settings.border_color }};
  border-radius: {{ section.settings.border_radius }}px;
  padding: 30px;
  margin: 30px auto;
  max-width: 1200px;
  font-family: 'Helvetica Neue', sans-serif;
">
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 30px;">
    <!-- Product Image -->
    <div style="flex: 1 1 40%;">
      {% if section.settings.product != blank %}
        {% assign product = all_products[section.settings.product] %}
        <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" style="width: 100%; border-radius: 8px;">
      {% else %}
        <div style="background: #eee; height: 300px; display: flex; align-items: center; justify-content: center;">No product selected</div>
      {% endif %}
    </div>

    <!-- Product Details -->
    <div style="flex: 1 1 55%;">
      {% if section.settings.product != blank %}
        <h2 style="font-size: 28px; margin-bottom: 10px;">{{ product.title }}</h2>
        <p style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">
          {% if product.compare_at_price > product.price %}
            <span style="text-decoration: line-through; margin-right: 10px;">{{ product.compare_at_price | money }}</span>
          {% endif %}
          <span>{{ product.price | money }}</span>
        </p>
        <div style="margin-bottom: 20px;">{{ product.description | truncatewords: 30 }}</div>

        <!-- Add to Cart Form -->
        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit" style="display: inline-block; padding: 12px 24px; background: black; color: white; border-radius: 6px; font-weight: bold; border: none; cursor: pointer;">
            Add to Cart
          </button>
        </form>
      {% endif %}

      {% if section.settings.custom_text != blank %}
        <div style="margin-top: 20px; font-size: 14px; font-style: italic;">
          {{ section.settings.custom_text }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Product Custom",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    },
    {
      "type": "textarea",
      "id": "custom_text",
      "label": "Custom text area",
      "default": "Add your promotional or additional content here."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1D1D1D"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D9D9D9"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Featured Product w/ Cart",
      "category": "Product"
    }
  ]
}
{% endschema %}