{% comment %}
  PZ FAQ — accordion, mirrors AG1's FAQ list / the existing faqs_GMgTWi section.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-faq pz-faq-{{ section.id }}">
  {% style %}
    .pz-faq-{{ section.id }} {
      background: {{ section.settings.background }};
      padding: 64px 24px;
      scroll-margin-top: 80px;
    }
    .pz-faq-{{ section.id }} .pz-faq-inner { max-width: 800px; margin: 0 auto; }
    .pz-faq-{{ section.id }} h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px; text-align: center; }
    .pz-faq-{{ section.id }} .pz-faq-sub { opacity: .75; text-align: center; max-width: 60ch; margin: 0 auto 32px; }
    .pz-faq-{{ section.id }} details {
      border-bottom: 1px solid #e8e8e8; padding: 16px 0;
    }
    .pz-faq-{{ section.id }} summary {
      cursor: pointer; list-style: none; display: flex; justify-content: space-between;
      align-items: center; font-weight: 700; font-size: 15px; gap: 12px;
    }
    .pz-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
    .pz-faq-{{ section.id }} summary .pz-faq-icon {
      flex: none; width: 20px; height: 20px; position: relative;
    }
    .pz-faq-{{ section.id }} summary .pz-faq-icon::before,
    .pz-faq-{{ section.id }} summary .pz-faq-icon::after {
      content: ''; position: absolute; background: currentColor; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
    }
    .pz-faq-{{ section.id }} summary .pz-faq-icon::before { width: 12px; height: 2px; }
    .pz-faq-{{ section.id }} summary .pz-faq-icon::after { width: 2px; height: 12px; transition: transform .15s ease; }
    .pz-faq-{{ section.id }} details[open] summary .pz-faq-icon::after { transform: translate(-50%, -50%) rotate(90deg) scaleY(0); }
    .pz-faq-{{ section.id }} .pz-faq-answer { padding-top: 12px; font-size: 14px; line-height: 1.6; opacity: .8; }
  {% endstyle %}
  <div class="pz-faq-inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-faq-sub">{{ section.settings.subheading }}</p>{% endif %}
    {% for block in section.blocks %}
      {% if block.type == 'faq' %}
        <details {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question }}
            <span class="pz-faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="pz-faq-answer">{{ block.settings.answer }}</div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "PZ FAQ",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-faq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We're here to help you make an informed decision." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I use PERFORM?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Take PERFORM 15-30 minutes before you start playing, then continue to sip during play to maintain hydration, energy, and focus.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I use PERFORM sports drink?", "answer": "<p>Take PERFORM 15-30 minutes before you start playing, then continue to sip during play to maintain hydration, energy, endurance, and focus.</p>" } },
        { "type": "faq", "settings": { "question": "Are 5 Point sports drinks suitable for all athletes?", "answer": "<p>Yes — PERFORM is formulated for anyone looking for clean hydration and focus during activity.</p>" } },
        { "type": "faq", "settings": { "question": "How much caffeine is in PERFORM?", "answer": "<p>Each serving contains a moderate, crash-free dose of natural caffeine.</p>" } }
      ]
    }
  ]
}
{% endschema %}
