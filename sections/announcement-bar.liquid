{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif

  case section.settings.marquee_divider
    when 'dot'
      assign divider_char = '•'
    when 'pipe'
      assign divider_char = '|'
    when 'star'
      assign divider_char = '✦'
    else
      assign divider_char = ''
  endcase
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  #shopify-section-{{ section.id }} .announcement-bar.announcement-bar--marquee {
    display: block;
    width: 100%;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .announcement-marquee {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    color: {{ section.settings.marquee_text_color }};
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
  }

  #shopify-section-{{ section.id }} .announcement-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: announcement-marquee-scroll var(--marquee-duration, 22s) linear infinite;
  }

  {% if section.settings.marquee_pause_on_hover %}
    #shopify-section-{{ section.id }} .announcement-marquee:hover .announcement-marquee__track {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes announcement-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--marquee-set-width, 100%)));
    }
  }

  #shopify-section-{{ section.id }} .announcement-marquee__set {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: {{ section.settings.marquee_item_gap }}px;
    padding-right: {{ section.settings.marquee_item_gap }}px;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: {{ section.settings.marquee_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    {% if section.settings.marquee_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link .icon-arrow {
    width: 0.9em;
    height: 0.9em;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__divider {
    opacity: 0.5;
    font-size: 0.85em;
  }

  #shopify-section-{{ section.id }} .announcement-marquee--static .announcement-marquee__track {
    animation: none;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .announcement-marquee--static .announcement-marquee__set {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    padding-right: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .announcement-marquee__item {
      font-size: {{ section.settings.marquee_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .announcement-marquee__set {
      gap: calc({{ section.settings.marquee_item_gap }}px * 0.6);
      padding-right: calc({{ section.settings.marquee_item_gap }}px * 0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .announcement-marquee__track {
      animation: none;
    }
  }
{%- endstyle -%}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}"{% if section.settings.marquee_background_color != blank %} style="background-color: {{ section.settings.marquee_background_color }};"{% endif %}>
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}

    {%- if announcement_bar -%}
      <announcement-marquee
        class="announcement-bar announcement-bar--marquee"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        data-speed="{{ section.settings.marquee_speed }}"
      >
        <div class="announcement-marquee">
          <div class="announcement-marquee__track" data-marquee-track>
            <div class="announcement-marquee__set">
              {%- for block in section.blocks -%}
                <span class="announcement-marquee__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="announcement-marquee__link animate-arrow">
                      <span>{{ block.settings.text | escape }}</span>
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </a>
                  {%- else -%}
                    <span>{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if divider_char != blank and forloop.last == false -%}
                  <span class="announcement-marquee__divider" aria-hidden="true">{{ divider_char }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </announcement-marquee>
      <script src="{{ 'announcement-marquee.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "Marquee style"
    },
    {
      "type": "color",
      "id": "marquee_background_color",
      "label": "Background color",
      "default": "#0b3d38"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "marquee_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "marquee_font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "marquee_uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "select",
      "id": "marquee_divider",
      "label": "Divider between items",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dot", "label": "Dot" },
        { "value": "pipe", "label": "Pipe" },
        { "value": "star", "label": "Star" }
      ],
      "default": "dot"
    },
    {
      "type": "range",
      "id": "marquee_item_gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px/s",
      "label": "Scroll speed",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "marquee_pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
