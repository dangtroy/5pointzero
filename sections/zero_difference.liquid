</svg>
  {{ section.settings.subtitle }}
  </p>

    {% endif %}

  </div>

    {% endif %}

    
    </div>
    <div class="work_smarter_list">
      <ul class="work_smarter_grid">
        {% for block in section.blocks %}
          <li>
            <div class="work_smarter_card">
              {% if block.settings.img != blank %}<img src="{{ block.settings.img | img_url:"master" }}" alt=""/>{% endif %}
              {% if block.settings.title != blank %}
              <h3>
                {{ block.settings.title }}
              </h3>
              {% endif %}
              {% if block.settings.text != blank %} 
              <div class="content">
                  {% if block.settings.text != blank %} {{ block.settings.text }} {% endif %}
              </div>
              {% endif %}
              
            </div>
          </li>
          {% endfor %}
      </ul> 


       {% if section.settings.btn_text != blank or section.settings.subtitle != blank %}
      <div class="btn_subtitle btn_subtitle_mobile">
      {% if section.settings.btn_text != blank %}
       <a href="{{ section.settings.btn_link }}" class="btn-outline">{{ section.settings.btn_text }}<svg xmlns="http://www.w3.org/2000/svg" width="53" height="12" viewBox="0 0 53 12" fill="none">
