{%- liquid
  case section.settings.divider_style
    when 'dot'
      assign divider_char = '•'
    when 'pipe'
      assign divider_char = '|'
    when 'star'
      assign divider_char = '✦'
    else
      assign divider_char = ''
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .marquee-bar {
    background: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .marquee-bar__viewport {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    color: {{ section.settings.text_color }};
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 32px, black calc(100% - 32px), transparent 100%);
  }

  #shopify-section-{{ section.id }} .marquee-bar__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-bar-scroll var(--marquee-duration, 22s) linear infinite;
  }

  {% if section.settings.pause_on_hover %}
    #shopify-section-{{ section.id }} .marquee-bar__viewport:hover .marquee-bar__track {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes marquee-bar-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--marquee-set-width, 100%)));
    }
  }

  #shopify-section-{{ section.id }} .announcement-marquee__set {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: {{ section.settings.item_gap }}px;
    padding-right: {{ section.settings.item_gap }}px;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 12px 0;
    font-size: {{ section.settings.font_size }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    {% if section.settings.uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__link svg {
    width: 0.9em;
    height: 0.9em;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .announcement-marquee__divider {
    opacity: 0.5;
    font-size: 0.85em;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .announcement-marquee__item {
      font-size: {{ section.settings.font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .announcement-marquee__set {
      gap: calc({{ section.settings.item_gap }}px * 0.6);
      padding-right: calc({{ section.settings.item_gap }}px * 0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .marquee-bar__track {
      animation: none;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="marquee-bar">
    <announcement-marquee
      class="marquee-bar__viewport"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
      data-speed="{{ section.settings.speed }}"
    >
      <div class="marquee-bar__track" data-marquee-track>
        <div class="announcement-marquee__set">
          {%- for block in section.blocks -%}
            <span class="announcement-marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-marquee__link animate-arrow">
                  <span>{{ block.settings.text | escape }}</span>
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </a>
              {%- else -%}
                <span>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
            {%- if divider_char != blank and forloop.last == false -%}
              <span class="announcement-marquee__divider" aria-hidden="true">{{ divider_char }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </announcement-marquee>
    <script src="{{ 'announcement-marquee.js' | asset_url }}" defer="defer"></script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Marquee Bar",
  "class": "marquee-bar-section",
  "max_blocks": 12,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0b3d38"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider between items",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dot", "label": "Dot" },
        { "value": "pipe", "label": "Pipe" },
        { "value": "star", "label": "Star" }
      ],
      "default": "dot"
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px/s",
      "label": "Scroll speed",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Bar",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
