{% comment %}
  PZ Nutrition Strip — per-serving facts numbers, AG1-style ("40 calories, 6g carbs...").
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-nutrition pz-nutrition-{{ section.id }}">
  {% style %}
    .pz-nutrition-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 56px 24px;
      scroll-margin-top: 80px;
    }
    .pz-nutrition-{{ section.id }} .pz-nutrition-inner { max-width: 1080px; margin: 0 auto; text-align: center; }
    .pz-nutrition-{{ section.id }} h2 { font-size: clamp(22px, 2.8vw, 30px); font-weight: 800; margin: 0 0 8px; }
    .pz-nutrition-{{ section.id }} .pz-nutrition-sub { opacity: .7; max-width: 60ch; margin: 0 auto 32px; }
    .pz-nutrition-{{ section.id }} .pz-nutrition-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 24px;
    }
    .pz-nutrition-{{ section.id }} .pz-fact-value {
      font-size: clamp(24px, 3vw, 32px); font-weight: 800; color: {{ section.settings.accent_color }};
    }
    .pz-nutrition-{{ section.id }} .pz-fact-label {
      font-size: 12px; text-transform: uppercase; letter-spacing: .04em; opacity: .65; margin-top: 4px;
    }
  {% endstyle %}
  <div class="pz-nutrition-inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-nutrition-sub">{{ section.settings.subheading }}</p>{% endif %}
    <div class="pz-nutrition-grid">
      {% for block in section.blocks %}
        {% if block.type == 'fact' %}
          <div {{ block.shopify_attributes }}>
            <div class="pz-fact-value">{{ block.settings.value }}</div>
            <div class="pz-fact-label">{{ block.settings.label }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PZ Nutrition Strip",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-nutrition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In Every Serving of PERFORM" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Built to fuel a full session on the court — nothing wasted, nothing extra." },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8447C" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#141414" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "0" },
        { "type": "text", "id": "label", "label": "Label", "default": "Sugar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Nutrition Strip",
      "blocks": [
        { "type": "fact", "settings": { "value": "10", "label": "Calories" } },
        { "type": "fact", "settings": { "value": "0g", "label": "Sugar" } },
        { "type": "fact", "settings": { "value": "0g", "label": "Carbs" } },
        { "type": "fact", "settings": { "value": "5", "label": "Electrolytes" } },
        { "type": "fact", "settings": { "value": "100mg", "label": "Caffeine" } }
      ]
    }
  ]
}
{% endschema %}
