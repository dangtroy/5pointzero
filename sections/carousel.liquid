{%- comment -%}
  Hero Product Carousel
  - Center card is the large "hero"; side cards peek at reduced scale
  - Auto-scrolls to the next card every X seconds (editable)
  - Infinite wrap-around loop, swipe support on mobile, dots + arrows
  - Every card fully editable: image, title, description, link, colors
  - Pauses on hover/touch, respects prefers-reduced-motion
  - Theme editor: selecting a block jumps the carousel to that card
{%- endcomment -%}

{%- liquid
  assign sid = 'hero-carousel-' | append: section.id
-%}

<style>
  #{{ sid }} {
    --hc-bg: {{ section.settings.color_background }};
    --hc-text: {{ section.settings.color_text }};
    --hc-star: {{ section.settings.color_star }};
    --hc-arrow: {{ section.settings.color_arrows }};
    --hc-card-width: {{ section.settings.card_width }}px;
    --hc-transition: {{ section.settings.transition_speed }}ms;
    --hc-side-scale: 0.8;
    --hc-side-opacity: 0.45;

    background-color: var(--hc-bg);
    padding: {{ section.settings.padding_vertical }}px 0;
    overflow: hidden;
  }

  #{{ sid }} .hc__heading {
    text-align: center;
    color: var(--hc-text);
    margin: 0 0 28px;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    {% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: 0.05em;
  }

  #{{ sid }} .hc__stage {
    position: relative;
    width: 100%;
    margin: 0 auto;
    /* height set by JS to the tallest card */
  }

  #{{ sid }} .hc__slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--hc-card-width);
    max-width: 86vw;
    transform: translateX(-50%) scale(0.6);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--hc-transition) cubic-bezier(0.33, 1, 0.68, 1),
      opacity var(--hc-transition) ease;
    will-change: transform, opacity;
  }

  #{{ sid }} .hc__slide.is-center {
    transform: translateX(-50%) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  #{{ sid }} .hc__slide.is-left {
    transform: translateX(-152%) scale(var(--hc-side-scale));
    opacity: var(--hc-side-opacity);
  }

  #{{ sid }} .hc__slide.is-right {
    transform: translateX(52%) scale(var(--hc-side-scale));
    opacity: var(--hc-side-opacity);
  }

  /* Card */
  #{{ sid }} .hc__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: {{ section.settings.card_radius }}px;
    padding: 32px 24px 36px;
    text-align: center;
    text-decoration: none;
    height: 100%;
    box-sizing: border-box;
  }

  #{{ sid }} .hc__image-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
  }

  #{{ sid }} .hc__image-wrap img,
  #{{ sid }} .hc__image-placeholder {
    display: block;
    width: auto;
    max-width: 70%;
    height: auto;
    max-height: 340px;
    object-fit: contain;
  }

  #{{ sid }} .hc__image-placeholder svg {
    width: 200px;
    height: 200px;
    opacity: 0.4;
  }

  #{{ sid }} .hc__stars {
    color: var(--hc-star);
    font-size: 22px;
    letter-spacing: 4px;
    margin-bottom: 16px;
    line-height: 1;
  }

  #{{ sid }} .hc__title {
    display: inline-block;
    width: 100%;
    padding: 14px 18px;
    margin: 0 0 18px;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    line-height: 1.2;
    {% if section.settings.title_uppercase %}text-transform: uppercase;{% endif %}
    letter-spacing: 0.02em;
    box-sizing: border-box;
  }

  #{{ sid }} .hc__description {
    margin: 0;
    color: var(--hc-text);
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.5;
  }

  #{{ sid }} .hc__button {
    display: inline-block;
    margin-top: 22px;
    padding: 13px 32px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    letter-spacing: 0.05em;
    {% if section.settings.button_uppercase %}text-transform: uppercase;{% endif %}
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #{{ sid }} .hc__button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  /* Arrows */
  #{{ sid }} .hc__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    background: transparent;
    border: 1.5px solid var(--hc-arrow);
    color: var(--hc-arrow);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  #{{ sid }} .hc__arrow:hover { opacity: 0.7; }
  #{{ sid }} .hc__arrow--prev { left: 3%; }
  #{{ sid }} .hc__arrow--next { right: 3%; }
  #{{ sid }} .hc__arrow svg { width: 18px; height: 18px; }

  /* Dots */
  #{{ sid }} .hc__dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  #{{ sid }} .hc__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    padding: 0;
    cursor: pointer;
    background: var(--hc-text);
    opacity: 0.3;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #{{ sid }} .hc__dot.is-active {
    opacity: 1;
    transform: scale(1.3);
  }

  /* Mobile: same behavior, side cards peek at the edges */
  @media screen and (max-width: 749px) {
    #{{ sid }} {
      --hc-card-width: 74vw;
      --hc-side-scale: 0.78;
      --hc-side-opacity: 0.35;
    }
    #{{ sid }} .hc__slide.is-left  { transform: translateX(-138%) scale(var(--hc-side-scale)); }
    #{{ sid }} .hc__slide.is-right { transform: translateX(38%) scale(var(--hc-side-scale)); }
    #{{ sid }} .hc__image-wrap img { max-height: 240px; }
    #{{ sid }} .hc__title { font-size: {{ section.settings.title_size | times: 0.8 | round }}px; }
    #{{ sid }} .hc__description { font-size: {{ section.settings.text_size | times: 0.9 | round }}px; }
    #{{ sid }} .hc__arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} .hc__slide { transition: none; }
  }
</style>

<section
  id="{{ sid }}"
  class="hero-product-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | default: 'Featured products' | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="hc__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="hc__stage" data-hc-stage>
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
        comment
          A button inside a linked card would nest <a> tags (invalid HTML),
          so when a button is present the button carries the link instead.
        endcomment
        if block.settings.button_label != blank
          assign tag = 'div'
        endif
      -%}
      <div
        class="hc__slide"
        data-hc-slide
        data-index="{{ forloop.index0 }}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
        {{ block.shopify_attributes }}
      >
        <{{ tag }}
          class="hc__card"
          {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
          style="background: {{ block.settings.color_card }};"
        >
          <div class="hc__image-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 749px) 74vw, {{ section.settings.card_width }}px"
                alt="{{ block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                data-hc-img
              >
            {%- else -%}
              <span class="hc__image-placeholder">{{ 'product-1' | placeholder_svg_tag }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.show_stars -%}
            <div class="hc__stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3
              class="hc__title"
              style="
                color: {{ block.settings.color_title_text }};
                background: linear-gradient(90deg, {{ block.settings.color_title_bg_1 }}, {{ block.settings.color_title_bg_2 }});
              "
            >{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="hc__description">{{ block.settings.description | escape }}</p>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a
              class="hc__button"
              href="{{ block.settings.button_link | default: block.settings.link | default: '#' }}"
              style="background: {{ block.settings.color_button_bg }}; color: {{ block.settings.color_button_text }};"
            >{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </{{ tag }}>
      </div>
    {%- endfor -%}

    {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
      <button type="button" class="hc__arrow hc__arrow--prev" data-hc-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="hc__arrow hc__arrow--next" data-hc-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    {%- endif -%}
  </div>

  {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    <div class="hc__dots" data-hc-dots role="tablist" aria-label="Choose slide">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="hc__dot{% if forloop.first %} is-active{% endif %}"
          data-hc-dot="{{ forloop.index0 }}"
          role="tab"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
  function initHeroCarousel() {
    var root = document.getElementById('{{ sid }}');
    if (!root || root.dataset.hcInit === 'true') return;
    root.dataset.hcInit = 'true';

    var stage = root.querySelector('[data-hc-stage]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hc-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-hc-dot]'));
    var n = slides.length;
    if (!n) return;

    var active = 0;
    var timer = null;
    var autoplay = root.dataset.autoplay === 'true' && n > 1;
    var interval = parseInt(root.dataset.interval, 10) || 4000;
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function render() {
      slides.forEach(function (slide, i) {
        var offset = (i - active + n) % n;
        slide.classList.remove('is-center', 'is-left', 'is-right');
        if (offset === 0) {
          slide.classList.add('is-center');
        } else if (offset === 1) {
          slide.classList.add('is-right');
        } else if (offset === n - 1 && n > 2) {
          slide.classList.add('is-left');
        }
        slide.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-selected', i === active ? 'true' : 'false');
      });
    }

    function setHeight() {
      var max = 0;
      slides.forEach(function (slide) {
        max = Math.max(max, slide.offsetHeight);
      });
      if (max) stage.style.height = max + 'px';
    }

    /* Recalculate height as each image finishes loading (lazy images load late) */
    root.querySelectorAll('[data-hc-img]').forEach(function (img) {
      if (img.complete) return;
      img.addEventListener('load', setHeight);
      img.addEventListener('error', setHeight);
    });

    function goTo(index) {
      active = (index + n) % n;
      render();
    }

    function next() { goTo(active + 1); }
    function prev() { goTo(active - 1); }

    function startAutoplay() {
      stopAutoplay();
      if (!root.isConnected) return;
      if (!autoplay || reducedMotion.matches) return;
      timer = setInterval(next, interval);
    }

    function stopAutoplay() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    /* Controls */
    var btnNext = root.querySelector('[data-hc-next]');
    var btnPrev = root.querySelector('[data-hc-prev]');
    if (btnNext) btnNext.addEventListener('click', function () { next(); startAutoplay(); });
    if (btnPrev) btnPrev.addEventListener('click', function () { prev(); startAutoplay(); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.dataset.hcDot, 10));
        startAutoplay();
      });
    });

    /* Click a side card to bring it to center */
    slides.forEach(function (slide, i) {
      slide.addEventListener('click', function (e) {
        if (i !== active) {
          e.preventDefault();
          goTo(i);
          startAutoplay();
        }
      });
    });

    /* Pause on hover / touch */
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);

    /* Swipe (mobile) */
    var touchX = null;
    stage.addEventListener('touchstart', function (e) {
      touchX = e.touches[0].clientX;
      stopAutoplay();
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); }
      touchX = null;
      startAutoplay();
    }, { passive: true });

    /* Keyboard */
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { next(); startAutoplay(); }
      if (e.key === 'ArrowLeft') { prev(); startAutoplay(); }
    });

    /* Pause when tab is hidden */
    document.addEventListener('visibilitychange', function () {
      document.hidden ? stopAutoplay() : startAutoplay();
    });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(setHeight, 150);
    });

    /* Theme editor: jump to the block being edited */
    document.addEventListener('shopify:block:select', function (e) {
      var el = e.target.closest ? e.target : null;
      var idx = slides.indexOf(e.target.closest('[data-hc-slide]'));
      if (idx > -1) { stopAutoplay(); goTo(idx); }
    });
    document.addEventListener('shopify:block:deselect', startAutoplay);

    reducedMotion.addEventListener
      ? reducedMotion.addEventListener('change', startAutoplay)
      : reducedMotion.addListener(startAutoplay);

    /* Init */
    render();
    setHeight();
    if (document.readyState === 'complete') {
      setHeight();
    } else {
      window.addEventListener('load', setHeight);
    }
    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }

  /* Theme editor: re-initialize when the section re-renders */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') initHeroCarousel();
  });
  })();
</script>

{% schema %}
{
  "name": "Hero Product Carousel",
  "tag": "section",
  "class": "hero-product-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional heading above the carousel"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Seconds between slides",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "default": 600,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Section background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "color_star",
      "label": "Stars",
      "default": "#A6F511"
    },
    {
      "type": "color",
      "id": "color_arrows",
      "label": "Arrows",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (desktop)",
      "min": 280,
      "max": 560,
      "step": 20,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 36,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase titles",
      "default": true
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "button_uppercase",
      "label": "Uppercase button text",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hydration + Energy + Endurance + Anti-Cramping + Focus"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — makes the whole card clickable"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show 5-star rating",
          "default": true
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave blank to hide the button",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Falls back to the card link if blank"
        },
        {
          "type": "color",
          "id": "color_button_bg",
          "label": "Button background",
          "default": "#A6F511"
        },
        {
          "type": "color",
          "id": "color_button_text",
          "label": "Button text",
          "default": "#111111"
        },
        {
          "type": "header",
          "content": "Card colors"
        },
        {
          "type": "color",
          "id": "color_card",
          "label": "Card background",
          "default": "#0A0A0A"
        },
        {
          "type": "color",
          "id": "color_title_bg_1",
          "label": "Title bar color (left)",
          "default": "#A6F511"
        },
        {
          "type": "color",
          "id": "color_title_bg_2",
          "label": "Title bar color (right)",
          "info": "Set both the same for a solid bar, or different for a gradient",
          "default": "#A6F511"
        },
        {
          "type": "color",
          "id": "color_title_text",
          "label": "Title text",
          "default": "#111111"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Product Carousel",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "PERFORM - PINK LEMONADE",
            "description": "Hydration + Energy + Endurance + Anti-Cramping + Focus",
            "color_title_bg_1": "#A6F511",
            "color_title_bg_2": "#A6F511"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "RECOVER - WILD BERRY",
            "description": "Muscle Repair + Joint Support + Bone Support + Anti-Inflammatory + Cellular Recovery",
            "color_title_bg_1": "#D6216E",
            "color_title_bg_2": "#D6216E"
          }
