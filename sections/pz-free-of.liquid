{% comment %}
  PZ Free Of — "Discover the difference of ZERO".
  Two-column brand statement: headline + copy on the left, a struck-out
  claim list on the right. Modeled on the brand's existing "Discover the
  difference" section so this page matches the rest of the site.
  Dark ground, so neon green reads at ~15:1 as the ZERO keyword.
  Mobile stacks — no horizontal scrolling.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-freeof pz-freeof-{{ section.id }}">
  {% style %}
    .pz-freeof-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 56px 16px;
      scroll-margin-top: 80px;
    }
    @media (min-width: 600px) {
      .pz-freeof-{{ section.id }} { padding: 88px 24px; }
    }
    .pz-freeof-{{ section.id }} .pz-freeof-inner {
      max-width: 1280px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start;
    }
    @media (min-width: 900px) {
      .pz-freeof-{{ section.id }} .pz-freeof-inner {
        grid-template-columns: {{ section.settings.left_width }}fr {{ 100 | minus: section.settings.left_width }}fr;
        gap: 64px;
      }
    }
    .pz-freeof-{{ section.id }} .pz-freeof-copy-col { min-width: 0; }

    .pz-freeof-{{ section.id }} h2 {
      font-size: clamp(32px, 4.6vw, 58px); font-weight: 900; margin: 0 0 22px;
      color: {{ section.settings.heading_color }};
      text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.02;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-highlight {
      color: {{ section.settings.accent_color }};
    }
    .pz-freeof-{{ section.id }} .pz-freeof-body {
      font-size: clamp(14px, 1.2vw, 16px); line-height: 1.65; opacity: .8; max-width: 52ch;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-body p { margin: 0 0 12px; }
    .pz-freeof-{{ section.id }} .pz-freeof-body p:last-child { margin-bottom: 0; }

    /* Claim list — one column on small screens so long claims never get
       cramped, two once there is room. No horizontal scrolling. */
    .pz-freeof-{{ section.id }} .pz-freeof-grid {
      min-width: 0;
      display: grid; grid-template-columns: 1fr; gap: 18px 28px;
    }
    @media (min-width: 600px) {
      .pz-freeof-{{ section.id }} .pz-freeof-grid { grid-template-columns: repeat(2, 1fr); gap: 22px 32px; }
    }

    .pz-freeof-{{ section.id }} .pz-freeof-item {
      min-width: 0; display: flex; align-items: center; gap: 14px;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-mark {
      flex: none;
      width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;
      border-radius: 50%;
      background: {{ section.settings.mark_bg_color }};
      color: {{ section.settings.mark_icon_color }};
      display: flex; align-items: center; justify-content: center;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-mark svg {
      width: 55%; height: 55%; display: block;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-claim {
      font-size: clamp(15px, 1.35vw, 19px); font-weight: 900; line-height: 1.15;
      text-transform: uppercase; letter-spacing: .01em;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-prefix {
      color: {{ section.settings.accent_color }};
    }

    .pz-freeof-{{ section.id }} .pz-freeof-note {
      grid-column: 1 / -1;
      margin: 28px 0 0; font-size: 12px; opacity: .45; line-height: 1.5; max-width: 70ch;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-link {
      display: inline-flex; align-items: center; gap: 8px; margin-top: 22px;
      font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
      color: {{ section.settings.text_color }}; text-decoration: none;
      border-bottom: 2px solid {{ section.settings.accent_color }}; padding-bottom: 4px;
    }
    .pz-freeof-{{ section.id }} .pz-freeof-link:hover { opacity: .7; }
  {% endstyle %}

  <div class="pz-freeof-inner">
    <div class="pz-freeof-copy-col">
      {% if section.settings.heading != blank or section.settings.heading_highlight != blank %}
        <h2>
          {{ section.settings.heading }}
          {%- if section.settings.heading_highlight != blank -%}
            {% if section.settings.quote_highlight %}
              <span class="pz-freeof-highlight">&ldquo;{{ section.settings.heading_highlight }}&rdquo;</span>
            {% else %}
              <span class="pz-freeof-highlight">{{ section.settings.heading_highlight }}</span>
            {% endif %}
          {%- endif -%}
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="pz-freeof-body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.link_text != blank and section.settings.link_url != blank %}
        <a class="pz-freeof-link" href="{{ section.settings.link_url }}">
          {{ section.settings.link_text }} <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    <div class="pz-freeof-grid">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="pz-freeof-item" {{ block.shopify_attributes }}>
            <span class="pz-freeof-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </span>
            <span class="pz-freeof-claim">
              {% if block.settings.prefix != blank %}
                <span class="pz-freeof-prefix">{{ block.settings.prefix }}</span>
              {% endif %}
              {{ block.settings.text }}
            </span>
          </div>
        {% endif %}
      {% endfor %}
      {% if section.settings.note != blank %}
        <p class="pz-freeof-note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PZ Free Of",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-zero" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover the difference of" },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted word", "info": "Shown in the accent color", "default": "Zero" },
    { "type": "checkbox", "id": "quote_highlight", "label": "Wrap highlighted word in quotes", "default": true },
    { "type": "richtext", "id": "body", "label": "Body copy" },
    { "type": "range", "id": "left_width", "label": "Left column width (%)", "min": 30, "max": 60, "step": 2, "default": 44 },
    { "type": "range", "id": "icon_size", "label": "Mark size (px)", "min": 24, "max": 56, "step": 2, "default": 38 },
    { "type": "textarea", "id": "note", "label": "Footnote", "info": "Optional. Use to cite where these claims come from." },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "link_text", "label": "Link text", "info": "Only shown when a URL is set below" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent", "info": "Used for the highlighted word and each claim's keyword", "default": "#96FF00" },
    { "type": "color", "id": "mark_bg_color", "label": "Mark background", "default": "#ffffff" },
    { "type": "color", "id": "mark_icon_color", "label": "Mark icon", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#ffffff" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Claim",
      "settings": [
        { "type": "text", "id": "prefix", "label": "Highlighted keyword", "info": "Shown in the accent color, e.g. ZERO", "default": "Zero" },
        { "type": "text", "id": "text", "label": "Claim", "info": "Must be supported by the product copy or Supplement Facts panel", "default": "Artificial Colors" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Free Of",
      "blocks": [
        { "type": "item", "settings": { "prefix": "Zero", "text": "Artificial Colors" } },
        { "type": "item", "settings": { "prefix": "Zero", "text": "Artificial Flavors" } },
        { "type": "item", "settings": { "prefix": "Zero", "text": "Artificial Sweeteners" } },
        { "type": "item", "settings": { "prefix": "Zero", "text": "Sugar" } },
        { "type": "item", "settings": { "prefix": "Zero", "text": "Calories" } },
        { "type": "item", "settings": { "prefix": "Zero", "text": "Gluten" } }
      ]
    }
  ]
}
{% endschema %}
