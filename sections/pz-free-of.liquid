{% comment %}
  PZ Free Of — "Discover the difference of Zero" checklist, matches AG1's
  "AG1 is free of" list and the existing discover_wGCgTk section.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-freeof pz-freeof-{{ section.id }}">
  {% style %}
    .pz-freeof-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 48px 16px;
      scroll-margin-top: 80px;
    }
    @media (min-width: 600px) {
      .pz-freeof-{{ section.id }} { padding: 64px 24px; }
    }
    .pz-freeof-{{ section.id }} .pz-freeof-inner {
      max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    }
    @media (max-width: 800px) { .pz-freeof-{{ section.id }} .pz-freeof-inner { grid-template-columns: 1fr; } }
    .pz-freeof-{{ section.id }} h2 { font-size: clamp(24px, 3vw, 32px); font-weight: 800; margin: 0 0 12px; color: {{ section.settings.heading_color }}; }
    .pz-freeof-{{ section.id }} .pz-freeof-copy { opacity: .85; line-height: 1.6; }
    .pz-freeof-{{ section.id }} .pz-freeof-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .pz-freeof-{{ section.id }} .pz-freeof-list li {
      display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px;
      border: 1px solid {{ section.settings.border_color }}; border-radius: 10px; padding: 12px 16px;
      background: {{ section.settings.card_background }};
    }
    .pz-freeof-{{ section.id }} .pz-freeof-list svg { flex: none; color: {{ section.settings.accent_color }}; }
  {% endstyle %}
  <div class="pz-freeof-inner">
    <div>
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="pz-freeof-copy">{{ section.settings.body }}</div>{% endif %}
    </div>
    <ul class="pz-freeof-list">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <li {{ block.shopify_attributes }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            {{ block.settings.text }}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "PZ Free Of",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-zero" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Zero Artificial Ingredients" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>What we don't put in is as important as what we do put in. No artificial colors, flavors, or sweeteners. No sugar, calories, or gluten.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Checkmark icon color", "default": "#96FF00" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "card_background", "label": "List item background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "List item border", "default": "#ececec" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Zero item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Zero artificial colors" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Free Of",
      "blocks": [
        { "type": "item", "settings": { "text": "Zero artificial colors" } },
        { "type": "item", "settings": { "text": "Zero artificial flavors" } },
        { "type": "item", "settings": { "text": "Zero artificial sweeteners" } },
        { "type": "item", "settings": { "text": "Zero GMOs" } },
        { "type": "item", "settings": { "text": "Zero irradiated ingredients" } }
      ]
    }
  ]
}
{% endschema %}
