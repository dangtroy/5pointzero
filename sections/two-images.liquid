{% schema %}
{
  "name": "Two Images Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "First Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Two Images Side by Side"
    }
  ]
}
{% endschema %}
<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
<div class="page-width">
<div class="two-images-section" style="background-color: {{ section.settings.background_color }};">
  <div class="image-wrapper">
    {% if section.settings.image_1 %}
      <img src="{{ section.settings.image_1 | img_url: '800x' }}" alt="Image 1">
    {% endif %}
    {% if section.settings.image_2 %}
      <img src="{{ section.settings.image_2 | img_url: '800x' }}" alt="Image 2">
    {% endif %}
  </div>
</div>
</div>
</div>
<style>
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
.two-images-section {
  padding: 20px;
  border-radius: 15px;
      padding-top: 36px;
}

.two-images-section .image-wrapper {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.two-images-section .image-wrapper img {
  width: 48%;
  height: auto;
  display: block;
}

@media (max-width: 767px) {
  .two-images-section .image-wrapper img {
    width: 100%;
  }
}
</style>