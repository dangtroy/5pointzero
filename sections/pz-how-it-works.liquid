{% comment %}
  PZ How It Works — intro copy + numbered steps. Doubles as the "Our Approach"
  section and the "How It Works" anchor target.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-how pz-how-{{ section.id }}">
  {% style %}
    .pz-how-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 64px 24px;
      scroll-margin-top: 80px;
    }
    .pz-how-{{ section.id }} .pz-how-inner { max-width: 900px; margin: 0 auto; text-align: center; }
    .pz-how-{{ section.id }} .pz-how-eyebrow {
      font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      color: {{ section.settings.accent_color }}; margin-bottom: 10px;
    }
    .pz-how-{{ section.id }} h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 14px; color: {{ section.settings.heading_color }}; }
    .pz-how-{{ section.id }} .pz-how-body { opacity: .85; line-height: 1.7; max-width: 68ch; margin: 0 auto 40px; }
    .pz-how-{{ section.id }} .pz-steps {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; text-align: left;
    }
    @media (max-width: 600px) {
      .pz-how-{{ section.id }} .pz-steps { grid-template-columns: 1fr; }
    }
    .pz-how-{{ section.id }} .pz-step { border: 1px solid {{ section.settings.border_color }}; border-radius: 14px; padding: 20px; background: {{ section.settings.card_background }}; }
    .pz-how-{{ section.id }} .pz-step-num {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%; background: {{ section.settings.accent_color }};
      color: {{ section.settings.accent_text_color }}; font-weight: 800; font-size: 13px; margin-bottom: 10px;
    }
    .pz-how-{{ section.id }} .pz-step-title { font-weight: 700; margin-bottom: 6px; }
    .pz-how-{{ section.id }} .pz-step-desc { font-size: 13px; opacity: .75; line-height: 1.5; }
  {% endstyle %}
  <div class="pz-how-inner">
    {% if section.settings.eyebrow != blank %}<div class="pz-how-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.body != blank %}<div class="pz-how-body">{{ section.settings.body }}</div>{% endif %}
    {% if section.blocks.size > 0 %}
      <div class="pz-steps">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="pz-step" {{ block.shopify_attributes }}>
              <div class="pz-step-num">{{ forloop.index }}</div>
              <div class="pz-step-title">{{ block.settings.title }}</div>
              <div class="pz-step-desc">{{ block.settings.description }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PZ How It Works",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How PERFORM Works" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>At 5 Point Zero, we focus on creating high-quality sports drinks that enhance performance, boost focus, and improve hydration — so pickleball players can play their best, longer.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8447C" },
    { "type": "color", "id": "accent_text_color", "label": "Text on accent color", "info": "Text color inside the numbered step circles", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#fafafa" },
    { "type": "color", "id": "card_background", "label": "Step card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Step card border", "default": "#ececec" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Mix" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Add one scoop to 16oz of water, 15-30 minutes before you play." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Mix", "description": "Add one scoop to 16oz of water, 15-30 minutes before you play." } },
        { "type": "step", "settings": { "title": "Sip", "description": "Keep sipping between points and during breaks to stay hydrated." } },
        { "type": "step", "settings": { "title": "Perform", "description": "Stay sharp, avoid cramps, and finish strong through the last point." } }
      ]
    }
  ]
}
{% endschema %}
