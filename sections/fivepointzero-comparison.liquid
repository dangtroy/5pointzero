{% comment %}
  5 Point Zero — Premium Comparison Section
  Shopify OS 2.0 custom section. Pure Liquid + HTML + CSS + minimal vanilla
  JS — no images required, no external fonts/libraries. All copy, rows, and
  competitor logos are editable via section settings and blocks.
{% endcomment %}
{%- liquid
  assign fpz_green = section.settings.accent_color | default: '#96FF00'
  assign fpz_black = section.settings.background_color | default: '#000000'
-%}
{%- if section.settings.anchor_id != blank -%}<div id="{{ section.settings.anchor_id }}" style="scroll-margin-top: 80px;"></div>{%- endif -%}
<section
  id="fivepointzero-comparison-{{ section.id }}"
  class="fpz-comparison"
  data-fpz-comparison
>
  {% style %}
    #fivepointzero-comparison-{{ section.id }} {
      --fpz-green: {{ fpz_green }};
      --fpz-black: {{ fpz_black }};
      --fpz-white: #FFFFFF;
      --fpz-gray: #BDBDBD;
      --fpz-red: #FF3B30;
      --fpz-border: rgba(255,255,255,0.15);
      --fpz-glow: color-mix(in srgb, var(--fpz-green) 35%, transparent);

      background: var(--fpz-black);
      color: var(--fpz-white);
      padding: 56px 16px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      overflow: hidden;
    }
    @media (min-width: 700px) {
      #fivepointzero-comparison-{{ section.id }} { padding: 88px 24px; }
    }
    #fivepointzero-comparison-{{ section.id }} * { box-sizing: border-box; }
    #fivepointzero-comparison-{{ section.id }} .fpz-inner {
      max-width: 1320px; margin: 0 auto;
    }

    /* Scroll-in reveal (JS toggles .fpz-in-view; CSS no-ops under reduced motion) */
    #fivepointzero-comparison-{{ section.id }} .fpz-reveal {
      opacity: 0; transform: translateY(18px);
      transition: opacity .6s ease, transform .6s ease;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-reveal.fpz-in-view {
      opacity: 1; transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      #fivepointzero-comparison-{{ section.id }} .fpz-reveal {
        opacity: 1; transform: none; transition: none;
      }
    }

    /* 1. Hero header */
    #fivepointzero-comparison-{{ section.id }} .fpz-hero {
      text-align: center; position: relative; margin-bottom: 48px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-hero-heading {
      font-size: clamp(34px, 7vw, 64px);
      font-weight: 900;
      font-style: italic;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      margin: 0 0 8px;
      color: var(--fpz-green);
      text-shadow: 0 0 24px var(--fpz-glow);
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-hero-score {
      font-size: clamp(16px, 3vw, 22px);
      font-weight: 700;
      letter-spacing: .06em;
      color: var(--fpz-white);
      margin: 0 0 28px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-statement-box {
      position: relative;
      max-width: 720px; margin: 0 auto;
      border: 1px solid var(--fpz-green);
      border-radius: 14px;
      padding: 24px 20px;
      box-shadow: 0 0 30px var(--fpz-glow), inset 0 0 20px color-mix(in srgb, var(--fpz-green) 6%, transparent);
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-statement-box p {
      margin: 0; font-size: clamp(15px, 2.2vw, 19px); line-height: 1.5; font-weight: 500;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-statement-highlight {
      display: block; margin-top: 6px; color: var(--fpz-green); font-weight: 800;
    }
    /* Decorative CSS-only flame/energy accents — pure gradients, no assets */
    #fivepointzero-comparison-{{ section.id }} .fpz-flame {
      position: absolute; top: 50%; width: 46px; height: 140px;
      transform: translateY(-50%);
      background: radial-gradient(closest-side, var(--fpz-green), transparent 70%);
      filter: blur(6px);
      opacity: .55;
      clip-path: polygon(50% 0%, 80% 25%, 65% 45%, 90% 70%, 50% 100%, 10% 70%, 35% 45%, 20% 25%);
      pointer-events: none;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-flame--left { left: -10px; }
    #fivepointzero-comparison-{{ section.id }} .fpz-flame--right { right: -10px; transform: translateY(-50%) scaleX(-1); }
    @media (max-width: 700px) {
      #fivepointzero-comparison-{{ section.id }} .fpz-flame { display: none; }
    }

    /* 2 & 3. Comparison table */
    #fivepointzero-comparison-{{ section.id }} .fpz-table-heading {
      text-align: center; text-transform: uppercase; font-style: italic; font-weight: 900;
      font-size: clamp(22px, 4vw, 32px); margin: 0 0 6px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-swipe-hint {
      display: none; text-align: center; font-size: 12px; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase; color: var(--fpz-green);
      margin: 0 0 14px;
    }
    @media (max-width: 800px) {
      #fivepointzero-comparison-{{ section.id }} .fpz-swipe-hint { display: block; }
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 16px;
      border: 1px solid var(--fpz-border);
      margin-top: 24px;
    }
    #fivepointzero-comparison-{{ section.id }} table {
      border-collapse: separate; border-spacing: 0;
      width: 100%; min-width: 720px;
    }
    #fivepointzero-comparison-{{ section.id }} thead th {
      background: #0a0a0a;
      padding: 18px 14px;
      font-size: 13px; letter-spacing: .04em; text-transform: uppercase; font-weight: 800;
      text-align: center; border-bottom: 1px solid var(--fpz-border);
      position: sticky; top: 0; z-index: 3;
    }
    #fivepointzero-comparison-{{ section.id }} thead th img {
      max-height: 28px; width: auto; display: inline-block; object-fit: contain;
    }
    #fivepointzero-comparison-{{ section.id }} th.fpz-col-label,
    #fivepointzero-comparison-{{ section.id }} td.fpz-col-label {
      text-align: left;
      position: sticky; left: 0; z-index: 2;
      background: #0a0a0a;
      min-width: 190px;
      font-weight: 700; font-size: 14px;
      border-right: 1px solid var(--fpz-border);
    }
    #fivepointzero-comparison-{{ section.id }} td.fpz-col-label { background: #050505; color: var(--fpz-white); }
    #fivepointzero-comparison-{{ section.id }} th.fpz-col-5pz,
    #fivepointzero-comparison-{{ section.id }} td.fpz-col-5pz {
      background: linear-gradient(180deg, color-mix(in srgb, var(--fpz-green) 14%, #000) 0%, color-mix(in srgb, var(--fpz-green) 6%, #000) 100%);
      border-left: 1px solid var(--fpz-green);
      border-right: 1px solid var(--fpz-green);
      min-width: 150px;
      transition: box-shadow .25s ease;
    }
    #fivepointzero-comparison-{{ section.id }} th.fpz-col-5pz { color: var(--fpz-green); text-shadow: 0 0 12px var(--fpz-glow); }
    #fivepointzero-comparison-{{ section.id }}:hover th.fpz-col-5pz,
    #fivepointzero-comparison-{{ section.id }}:hover td.fpz-col-5pz {
      box-shadow: 0 0 24px var(--fpz-glow) inset;
    }
    #fivepointzero-comparison-{{ section.id }} th.fpz-col-competitor,
    #fivepointzero-comparison-{{ section.id }} td.fpz-col-competitor {
      min-width: 130px; color: var(--fpz-gray);
    }
    #fivepointzero-comparison-{{ section.id }} tbody td {
      padding: 0 14px; height: 52px;
      text-align: center; font-size: 14px; font-weight: 600;
      border-bottom: 1px solid var(--fpz-border);
      vertical-align: middle;
    }
    #fivepointzero-comparison-{{ section.id }} tr.fpz-row-category td {
      background: #0d0d0d; color: var(--fpz-green);
      font-weight: 800; text-transform: uppercase; letter-spacing: .05em; font-size: 12px;
      text-align: left; height: 42px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; border-radius: 50%; flex: none;
      transition: transform .2s ease;
    }
    #fivepointzero-comparison-{{ section.id }} tbody tr:hover .fpz-icon { transform: scale(1.12); }
    #fivepointzero-comparison-{{ section.id }} .fpz-icon--check { background: var(--fpz-green); color: #04210a; }
    #fivepointzero-comparison-{{ section.id }} .fpz-icon--x { background: var(--fpz-red); color: #2a0705; }
    #fivepointzero-comparison-{{ section.id }} .fpz-cell-empty { color: var(--fpz-gray); opacity: .5; }
    @media (prefers-reduced-motion: reduce) {
      #fivepointzero-comparison-{{ section.id }} .fpz-icon,
      #fivepointzero-comparison-{{ section.id }} th.fpz-col-5pz,
      #fivepointzero-comparison-{{ section.id }} td.fpz-col-5pz {
        transition: none;
      }
    }

    /* 4. Winning callout */
    #fivepointzero-comparison-{{ section.id }} .fpz-winning {
      text-align: center; max-width: 780px; margin: 56px auto 0;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-winning h3 {
      font-size: clamp(20px, 4vw, 30px); font-weight: 900; font-style: italic;
      text-transform: uppercase; margin: 0 0 14px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-winning p {
      font-size: clamp(14px, 2vw, 17px); color: var(--fpz-gray); line-height: 1.6; margin: 0 0 14px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-winning-highlight {
      display: inline-block; color: var(--fpz-green); font-weight: 800;
    }

    /* 5. Clean ingredient callout */
    #fivepointzero-comparison-{{ section.id }} .fpz-clean {
      max-width: 1000px; margin: 56px auto 0; text-align: center;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-clean h3 {
      font-size: clamp(18px, 3.4vw, 26px); font-weight: 900; font-style: italic;
      text-transform: uppercase; margin: 0 0 28px;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-clean-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
    }
    @media (min-width: 700px) {
      #fivepointzero-comparison-{{ section.id }} .fpz-clean-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; }
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-clean-item {
      min-width: 0;
      display: flex; align-items: center; gap: 10px;
      border: 1px solid var(--fpz-border); border-radius: 12px;
      padding: 14px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .02em;
      text-align: left;
    }
    #fivepointzero-comparison-{{ section.id }} .fpz-clean-item svg {
      flex: none; color: var(--fpz-green);
    }
  {% endstyle %}

  <div class="fpz-inner">
    <div class="fpz-hero fpz-reveal">
      <div class="fpz-flame fpz-flame--left" aria-hidden="true"></div>
      <div class="fpz-flame fpz-flame--right" aria-hidden="true"></div>
      {% if section.settings.heading != blank %}
        <h2 class="fpz-hero-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.score != blank %}
        <p class="fpz-hero-score">{{ section.settings.score }}</p>
      {% endif %}
      {% if section.settings.statement != blank %}
        <div class="fpz-statement-box">
          <p>
            {{ section.settings.statement }}
            {% if section.settings.statement_highlight != blank %}
              <span class="fpz-statement-highlight">{{ section.settings.statement_highlight }}</span>
            {% endif %}
          </p>
        </div>
      {% endif %}
    </div>

    {%- assign rows = section.blocks | where: 'type', 'comparison_row' -%}
    {% if rows.size > 0 %}
      <div class="fpz-reveal">
        {% if section.settings.table_title != blank %}
          <h3 class="fpz-table-heading">{{ section.settings.table_title }}</h3>
        {% endif %}
        <p class="fpz-swipe-hint">Swipe to compare →</p>

        <div class="fpz-table-wrap">
          <table>
            <thead>
              <tr>
                <th class="fpz-col-label" scope="col"></th>
                <th class="fpz-col-5pz" scope="col">
                  {% if section.settings.logo_5pz %}
                    {{ section.settings.logo_5pz | image_url: width: 160 | image_tag: alt: '5 Point Zero' }}
                  {% else %}
                    5 Point Zero
                  {% endif %}
                </th>
                <th class="fpz-col-competitor" scope="col">
                  {% if section.settings.logo_lmnt %}
                    {{ section.settings.logo_lmnt | image_url: width: 140 | image_tag: alt: 'LMNT' }}
                  {% else %}
                    LMNT
                  {% endif %}
                </th>
                <th class="fpz-col-competitor" scope="col">
                  {% if section.settings.logo_liquidiv %}
                    {{ section.settings.logo_liquidiv | image_url: width: 140 | image_tag: alt: 'Liquid I.V.' }}
                  {% else %}
                    Liquid I.V.
                  {% endif %}
                </th>
                <th class="fpz-col-competitor" scope="col">
                  {% if section.settings.logo_gatorade %}
                    {{ section.settings.logo_gatorade | image_url: width: 140 | image_tag: alt: 'Gatorade' }}
                  {% else %}
                    Gatorade
                  {% endif %}
                </th>
              </tr>
            </thead>
            <tbody>
              {% for block in rows %}
                {% liquid
                  assign is_category = false
                  if block.settings.row_type == 'category'
                    assign is_category = true
                  endif
                %}
                {% if is_category %}
                  <tr class="fpz-row-category" {{ block.shopify_attributes }}>
                    <td colspan="5">{{ block.settings.label }}</td>
                  </tr>
                {% else %}
                  <tr {{ block.shopify_attributes }}>
                    <td class="fpz-col-label">{{ block.settings.label }}</td>
                    <td class="fpz-col-5pz">
                      {% case block.settings.fivepointzero_status %}
                        {% when 'check' %}
                          <span class="fpz-icon fpz-icon--check" role="img" aria-label="Contains">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
                          </span>
                        {% when 'x' %}
                          <span class="fpz-icon fpz-icon--x" role="img" aria-label="Does not contain">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                          </span>
                        {% when 'text' %}
                          {{ block.settings.fivepointzero_value }}
                        {% else %}
                          <span class="fpz-cell-empty">—</span>
                      {% endcase %}
                    </td>
                    <td class="fpz-col-competitor">
                      {% case block.settings.lmnt_status %}
                        {% when 'check' %}
                          <span class="fpz-icon fpz-icon--check" role="img" aria-label="Contains">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
                          </span>
                        {% when 'x' %}
                          <span class="fpz-icon fpz-icon--x" role="img" aria-label="Does not contain">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                          </span>
                        {% when 'text' %}
                          {{ block.settings.lmnt_value }}
                        {% else %}
                          <span class="fpz-cell-empty">—</span>
                      {% endcase %}
                    </td>
                    <td class="fpz-col-competitor">
                      {% case block.settings.liquidiv_status %}
                        {% when 'check' %}
                          <span class="fpz-icon fpz-icon--check" role="img" aria-label="Contains">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
                          </span>
                        {% when 'x' %}
                          <span class="fpz-icon fpz-icon--x" role="img" aria-label="Does not contain">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                          </span>
                        {% when 'text' %}
                          {{ block.settings.liquidiv_value }}
                        {% else %}
                          <span class="fpz-cell-empty">—</span>
                      {% endcase %}
                    </td>
                    <td class="fpz-col-competitor">
                      {% case block.settings.gatorade_status %}
                        {% when 'check' %}
                          <span class="fpz-icon fpz-icon--check" role="img" aria-label="Contains">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
                          </span>
                        {% when 'x' %}
                          <span class="fpz-icon fpz-icon--x" role="img" aria-label="Does not contain">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
                          </span>
                        {% when 'text' %}
                          {{ block.settings.gatorade_value }}
                        {% else %}
                          <span class="fpz-cell-empty">—</span>
                      {% endcase %}
                    </td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}

    {% if section.settings.winning_headline != blank or section.settings.winning_copy != blank %}
      <div class="fpz-winning fpz-reveal">
        {% if section.settings.winning_headline != blank %}
          <h3>{{ section.settings.winning_headline }}</h3>
        {% endif %}
        {% if section.settings.winning_copy != blank %}
          <p>{{ section.settings.winning_copy }}</p>
        {% endif %}
        {% if section.settings.winning_highlight != blank %}
          <span class="fpz-winning-highlight">{{ section.settings.winning_highlight }}</span>
        {% endif %}
      </div>
    {% endif %}

    {%- assign clean_items = section.blocks | where: 'type', 'clean_item' -%}
    {% if clean_items.size > 0 %}
      <div class="fpz-clean fpz-reveal">
        {% if section.settings.clean_heading != blank %}
          <h3>{{ section.settings.clean_heading }}</h3>
        {% endif %}
        <div class="fpz-clean-grid">
          {% for block in clean_items %}
            <div class="fpz-clean-item" {{ block.shopify_attributes }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
              {{ block.settings.label }}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('fivepointzero-comparison-{{ section.id }}');
  if (!root) return;

  var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var reveals = root.querySelectorAll('.fpz-reveal');

  if (prefersReduced || !('IntersectionObserver' in window)) {
    reveals.forEach(function (el) { el.classList.add('fpz-in-view'); });
    return;
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('fpz-in-view');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  reveals.forEach(function (el) { observer.observe(el); });
})();
</script>

{% schema %}
{
  "name": "5PZ Comparison",
  "tag": "section",
  "class": "fpz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "For in-page nav links, e.g. pz-compare", "default": "pz-compare" },
    { "type": "header", "content": "Hero header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WE WIN." },
    { "type": "text", "id": "score", "label": "Score line", "default": "15–2. 15–3. 15–3." },
    { "type": "textarea", "id": "statement", "label": "Statement", "default": "Fuel should lift you up, not weigh you down." },
    { "type": "text", "id": "statement_highlight", "label": "Statement highlight (neon green line)", "default": "Skip the spikes, crashes, and chemicals." },

    { "type": "header", "content": "Comparison table" },
    { "type": "text", "id": "table_title", "label": "Table title", "default": "SEE HOW WE STACK UP" },

    { "type": "header", "content": "Competitor logos (optional)" },
    { "type": "image_picker", "id": "logo_5pz", "label": "5 Point Zero logo" },
    { "type": "image_picker", "id": "logo_lmnt", "label": "LMNT logo" },
    { "type": "image_picker", "id": "logo_liquidiv", "label": "Liquid I.V. logo" },
    { "type": "image_picker", "id": "logo_gatorade", "label": "Gatorade logo" },

    { "type": "header", "content": "Winning callout" },
    { "type": "text", "id": "winning_headline", "label": "Winning headline", "default": "MORE THAN JUST FLAVORED SALT WATER." },
    { "type": "textarea", "id": "winning_copy", "label": "Winning copy", "default": "5 Point Zero combines hydration, energy, endurance, focus, and anti-cramping support in one performance drink." },
    { "type": "text", "id": "winning_highlight", "label": "Winning highlight (neon green)", "default": "HYDRATION + ENERGY + ENDURANCE + FOCUS + ANTI-CRAMPING" },

    { "type": "header", "content": "Clean ingredient callout" },
    { "type": "text", "id": "clean_heading", "label": "Clean callout heading", "default": "WHAT WE DON'T PUT IN MATTERS TOO." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Primary accent (neon green)", "default": "#96FF00" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "select",
          "id": "row_type",
          "label": "Row type",
          "options": [
            { "value": "category", "label": "Category header" },
            { "value": "comparison", "label": "Comparison row" }
          ],
          "default": "comparison"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Ingredient / category name" },
        { "type": "header", "content": "5 Point Zero" },
        {
          "type": "select", "id": "fivepointzero_status", "label": "Status",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "x", "label": "X" },
            { "value": "text", "label": "Text / value" },
            { "value": "empty", "label": "Empty (—)" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "fivepointzero_value", "label": "Value (used when Status = Text)" },
        { "type": "header", "content": "LMNT" },
        {
          "type": "select", "id": "lmnt_status", "label": "Status",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "x", "label": "X" },
            { "value": "text", "label": "Text / value" },
            { "value": "empty", "label": "Empty (—)" }
          ],
          "default": "x"
