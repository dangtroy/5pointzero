{% comment %}
  PZ Ingredient Cards — horizontal scroll cards, AG1-style ingredient deep-dive
  (category eyebrow + name + description + optional image).
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-ingredients pz-ingredients-{{ section.id }}">
  {% style %}
    .pz-ingredients-{{ section.id }} {
      background: {{ section.settings.background }};
      padding: 64px 0;
      scroll-margin-top: 80px;
    }
    .pz-ingredients-{{ section.id }} .pz-ingredients-head {
      max-width: 1280px; margin: 0 auto 32px; padding: 0 16px; text-align: center;
    }
    @media (min-width: 600px) {
      .pz-ingredients-{{ section.id }} .pz-ingredients-head { padding: 0 24px; }
    }
    .pz-ingredients-{{ section.id }} h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px; color: {{ section.settings.heading_color }}; }
    .pz-ingredients-{{ section.id }} .pz-ingredients-sub { opacity: .75; max-width: 60ch; margin: 0 auto; color: {{ section.settings.text_color }}; }
    .pz-ingredients-{{ section.id }} .pz-card-row {
      display: flex; gap: 16px; overflow-x: auto; padding: 4px 16px 12px;
      scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    }
    .pz-ingredients-{{ section.id }} .pz-card {
      flex: 0 0 260px; min-width: 0; scroll-snap-align: start;
      border: 1px solid {{ section.settings.border_color }}; border-radius: 16px; overflow: hidden;
      background: {{ section.settings.card_background }}; display: flex; flex-direction: column;
      color: {{ section.settings.text_color }};
    }
    @media (max-width: 600px) {
      .pz-ingredients-{{ section.id }} .pz-card { flex-basis: 78vw; }
    }
    .pz-ingredients-{{ section.id }} .pz-card-img {
      aspect-ratio: 4 / 3; background: #f4f4f4; overflow: hidden;
    }
    .pz-ingredients-{{ section.id }} .pz-card-img img,
    .pz-ingredients-{{ section.id }} .pz-card-img video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pz-ingredients-{{ section.id }} .pz-card-body { padding: 18px; }
    .pz-ingredients-{{ section.id }} .pz-card-eyebrow {
      font-size: 11px; text-transform: uppercase; letter-spacing: .05em; font-weight: 700;
      color: {{ section.settings.accent_color }}; margin-bottom: 6px;
    }
    .pz-ingredients-{{ section.id }} .pz-card-name { font-size: 17px; font-weight: 800; margin-bottom: 6px; }
    .pz-ingredients-{{ section.id }} .pz-card-desc { font-size: 13px; opacity: .75; line-height: 1.5; }
  {% endstyle %}
  <div class="pz-ingredients-head">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-ingredients-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>
  <div class="pz-card-row">
    {% for block in section.blocks %}
      {% if block.type == 'ingredient' %}
        <div class="pz-card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="pz-card-img">
              {{ block.settings.image | image_url: width: 520 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            </div>
          {% elsif block.settings.fallback_filename != blank %}
            <div class="pz-card-img">
              <img src="{{ block.settings.fallback_filename | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="1216" height="896">
            </div>
          {% endif %}
          <div class="pz-card-body">
            {% if block.settings.eyebrow != blank %}<div class="pz-card-eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}
            <div class="pz-card-name">{{ block.settings.name }}</div>
            <div class="pz-card-desc">{{ block.settings.description }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "PZ Ingredient Cards",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Inside PERFORM" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every ingredient is chosen for one job: keeping you sharp for all five points." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Category eyebrow text", "default": "#96FF00" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Card text color", "default": "#141414" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#ececec" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#fafafa" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_filename", "label": "Bundled asset filename", "info": "Advanced: filename of an image already in the theme's assets folder, used when no Image is picked above" },
        { "type": "text", "id": "eyebrow", "label": "Category", "default": "Electrolytes" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sodium & Potassium" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Replaces what you sweat out on the court to prevent cramping and keep you hydrated." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Ingredient Cards",
      "blocks": [
        { "type": "ingredient", "settings": { "eyebrow": "Electrolytes", "name": "Sodium & Potassium", "description": "Replaces what you sweat out on the court to prevent cramping." } },
        { "type": "ingredient", "settings": { "eyebrow": "Focus", "name": "L-Theanine", "description": "Smooth, jitter-free focus for long rallies and tournament days." } },
        { "type": "ingredient", "settings": { "eyebrow": "Energy", "name": "Natural Caffeine", "description": "Crash-free energy sourced from green tea, not synthetic stimulants." } },
        { "type": "ingredient", "settings": { "eyebrow": "Hydration", "name": "Coconut Water", "description": "Organic coconut water for real, whole-food hydration." } }
      ]
    }
  ]
}
{% endschema %}
