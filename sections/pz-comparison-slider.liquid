{% comment %}
  PZ Comparison Slider — full-bleed swipeable carousel for pre-designed
  comparison graphics (e.g. "5 Point Zero vs. Gatorade"). Same slider
  mechanics as the hero gallery: scroll-snap track, prev/next arrows,
  dot indicators, touch-friendly on mobile, click/trackpad on desktop.

  Each block can use a merchant-uploaded image, or fall back to a bundled
  theme asset (see fallback_filename) so the section works out of the box.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-cslider pz-cslider-{{ section.id }}">
  {% style %}
    .pz-cslider-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 64px 0;
      scroll-margin-top: 80px;
    }
    .pz-cslider-{{ section.id }} .pz-cslider-head {
      max-width: 1280px; margin: 0 auto 32px; padding: 0 24px; text-align: center;
    }
    .pz-cslider-{{ section.id }} h2 {
      font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px;
      color: {{ section.settings.heading_color }};
    }
    .pz-cslider-{{ section.id }} .pz-cslider-sub { opacity: .75; max-width: 60ch; margin: 0 auto; }

    .pz-cslider-{{ section.id }} .pz-cslider-viewport {
      position: relative; max-width: 560px; margin: 0 auto;
    }
    .pz-cslider-{{ section.id }} .pz-cslider-track {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
      scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none;
      border-radius: {{ section.settings.corner_radius }}px;
    }
    .pz-cslider-{{ section.id }} .pz-cslider-track::-webkit-scrollbar { display: none; }
    .pz-cslider-{{ section.id }} .pz-cslide {
      flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always;
    }
    .pz-cslider-{{ section.id }} .pz-cslide img {
      width: 100%; height: auto; display: block;
    }
    .pz-cslider-{{ section.id }} .pz-cslide a { display: block; }

    .pz-cslider-{{ section.id }} .pz-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 40px; height: 40px; border-radius: 50%; border: none;
      background: rgba(255,255,255,.9); color: #141414;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; z-index: 2; box-shadow: 0 2px 8px rgba(0,0,0,.25);
    }
    .pz-cslider-{{ section.id }} .pz-arrow-prev { left: -8px; }
    .pz-cslider-{{ section.id }} .pz-arrow-next { right: -8px; }
    .pz-cslider-{{ section.id }} .pz-arrow:disabled { opacity: 0; pointer-events: none; }
    @media (min-width: 700px) {
      .pz-cslider-{{ section.id }} .pz-arrow-prev { left: -20px; }
      .pz-cslider-{{ section.id }} .pz-arrow-next { right: -20px; }
    }

    .pz-cslider-{{ section.id }} .pz-dots {
      display: flex; justify-content: center; gap: 6px; margin-top: 16px;
    }
    .pz-cslider-{{ section.id }} .pz-dot {
      width: 7px; height: 7px; border-radius: 50%; border: none; padding: 0; cursor: pointer;
      background: {{ section.settings.dot_color }}; opacity: .35;
    }
    .pz-cslider-{{ section.id }} .pz-dot.is-active { opacity: 1; width: 20px; border-radius: 4px; }
  {% endstyle %}

  <div class="pz-cslider-head">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-cslider-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="pz-cslider-viewport">
    <div class="pz-cslider-track" id="pz-ctrack-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          {% liquid
            assign img_url = nil
            if block.settings.image
              assign img_url = block.settings.image | image_url: width: 1200
            elsif block.settings.fallback_filename != blank
              assign img_url = block.settings.fallback_filename | asset_url
            endif
          %}
          <div class="pz-cslide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if img_url %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">
                  <img src="{{ img_url }}" alt="{{ block.settings.alt_text | default: section.settings.heading | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1080" height="1080">
                </a>
              {% else %}
                <img src="{{ img_url }}" alt="{{ block.settings.alt_text | default: section.settings.heading | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1080" height="1080">
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% assign slide_count = section.blocks | where: 'type', 'slide' | size %}
    {% if slide_count > 1 %}
      <button type="button" class="pz-arrow pz-arrow-prev" id="pz-cprev-{{ section.id }}" aria-label="Previous comparison">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="pz-arrow pz-arrow-next" id="pz-cnext-{{ section.id }}" aria-label="Next comparison">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    {% endif %}
  </div>

  {% if slide_count > 1 %}
    <div class="pz-dots" id="pz-cdots-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button type="button" class="pz-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to comparison {{ forloop.index }}"></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
(function () {
  var root = document.querySelector('.pz-cslider-{{ section.id }}');
  if (!root) return;

  var track = root.querySelector('#pz-ctrack-{{ section.id }}');
  if (!track) return;
  var slides = Array.prototype.slice.call(track.querySelectorAll('.pz-cslide'));
  var dots = root.querySelectorAll('#pz-cdots-{{ section.id }} .pz-dot');
  var prevBtn = root.querySelector('#pz-cprev-{{ section.id }}');
  var nextBtn = root.querySelector('#pz-cnext-{{ section.id }}');

  function goTo(index) {
    index = Math.max(0, Math.min(index, slides.length - 1));
    track.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
  }

  function setActive(index) {
    dots.forEach(function (d) { d.classList.toggle('is-active', +d.dataset.index === index); });
    if (prevBtn) prevBtn.disabled = index === 0;
    if (nextBtn) nextBtn.disabled = index === slides.length - 1;
  }

  dots.forEach(function (d) {
    d.addEventListener('click', function () { goTo(+d.dataset.index); });
  });
  if (prevBtn) prevBtn.addEventListener('click', function () {
    goTo(Math.round(track.scrollLeft / track.clientWidth) - 1);
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    goTo(Math.round(track.scrollLeft / track.clientWidth) + 1);
  });

  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
          setActive(+entry.target.dataset.index);
        }
      });
    }, { root: track, threshold: [0.6] });
    slides.forEach(function (s) { observer.observe(s); });
  }

  setActive(0);
})();
</script>

{% schema %}
{
  "name": "PZ Comparison Slider",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-compare-slider" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dare to Compare" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through and see how 5 Point Zero stacks up against the competition." },
    { "type": "range", "id": "corner_radius", "label": "Corner radius (px)", "min": 0, "max": 32, "step": 2, "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#141414" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Comparison image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled fallback image below" },
        { "type": "text", "id": "fallback_filename", "label": "Bundled asset filename", "info": "Advanced: filename of an image already uploaded to the theme's assets folder, used when no Image is picked above" },
        { "type": "text", "id": "alt_text", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Comparison Slider",
      "blocks": [
        { "type": "slide", "settings": { "fallback_filename": "pz-compare-gatorade.png", "alt_text": "5 Point Zero vs Gatorade ingredient comparison" } },
        { "type": "slide", "settings": { "fallback_filename": "pz-compare-lmnt.png", "alt_text": "5 Point Zero vs LMNT ingredient comparison" } },
        { "type": "slide", "settings": { "fallback_filename": "pz-compare-liquid-iv.png", "alt_text": "5 Point Zero vs Liquid IV ingredient comparison" } }
      ]
    }
  ]
}
{% endschema %}
