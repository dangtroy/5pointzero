{% comment %}
  PZ Pro Endorsements — athlete/pro cards (photo, name, credential, quote).
  Ships with clearly-marked placeholder content; swap photos/copy via the
  theme editor blocks.
{% endcomment %}
<section id="{{ section.settings.anchor_id }}" class="pz-pros pz-pros-{{ section.id }}">
  {% style %}
    .pz-pros-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding: 48px 0;
      scroll-margin-top: 80px;
    }
    @media (min-width: 600px) {
      .pz-pros-{{ section.id }} { padding: 64px 0; }
    }
    .pz-pros-{{ section.id }} .pz-pros-head {
      max-width: 1280px; margin: 0 auto 32px; padding: 0 16px; text-align: center;
    }
    @media (min-width: 600px) {
      .pz-pros-{{ section.id }} .pz-pros-head { padding: 0 24px; }
    }
    .pz-pros-{{ section.id }} h2 {
      font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px;
      color: {{ section.settings.heading_color }};
    }
    .pz-pros-{{ section.id }} .pz-pros-sub { opacity: .75; max-width: 60ch; margin: 0 auto; }
    .pz-pros-{{ section.id }} .pz-pros-row {
      display: flex; gap: 16px; overflow-x: auto; padding: 4px 16px 12px;
      scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
      justify-content: safe center; max-width: 1280px; margin: 0 auto;
    }
    @media (min-width: 600px) {
      .pz-pros-{{ section.id }} .pz-pros-row { gap: 20px; padding: 4px 24px 12px; }
    }
    .pz-pros-{{ section.id }} .pz-pro-card {
      flex: 0 0 260px; scroll-snap-align: start; min-width: 0;
      border: 1px solid {{ section.settings.border_color }}; border-radius: 16px; overflow: hidden;
      background: {{ section.settings.card_background }};
    }
    @media (max-width: 600px) {
      .pz-pros-{{ section.id }} .pz-pro-card { flex-basis: 78vw; }
    }
    .pz-pros-{{ section.id }} .pz-pro-photo {
      aspect-ratio: 4 / 5; background: #eee; position: relative; overflow: hidden;
    }
    .pz-pros-{{ section.id }} .pz-pro-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pz-pros-{{ section.id }} .pz-pro-photo .pz-pro-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #e9e9e9, #f6f6f6); color: #b3b3b3;
    }
    .pz-pros-{{ section.id }} .pz-pro-body { padding: 16px; text-align: center; }
    .pz-pros-{{ section.id }} .pz-pro-quote { font-size: 13px; line-height: 1.5; opacity: .85; margin-bottom: 10px; min-height: 3.9em; }
    .pz-pros-{{ section.id }} .pz-pro-name { font-weight: 800; font-size: 14px; }
    .pz-pros-{{ section.id }} .pz-pro-credential {
      font-size: 11px; text-transform: uppercase; letter-spacing: .04em; font-weight: 700;
      color: {{ section.settings.accent_color }};
    }
  {% endstyle %}

  <div class="pz-pros-head">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<p class="pz-pros-sub">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="pz-pros-row">
    {% for block in section.blocks %}
      {% if block.type == 'pro' %}
        <div class="pz-pro-card" {{ block.shopify_attributes }}>
          <div class="pz-pro-photo">
            {% if block.settings.photo %}
              {{ block.settings.photo | image_url: width: 520 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {% elsif block.settings.fallback_filename != blank %}
              <img src="{{ block.settings.fallback_filename | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="896" height="1152">
            {% else %}
              <div class="pz-pro-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              </div>
            {% endif %}
          </div>
          <div class="pz-pro-body">
            <div class="pz-pro-quote">"{{ block.settings.quote }}"</div>
            <div class="pz-pro-name">{{ block.settings.name }}</div>
            <div class="pz-pro-credential">{{ block.settings.credential }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "PZ Pro Endorsements",
  "tag": "section",
  "class": "pz-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "pz-pros" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted By The Pros" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Ranked pickleball players rely on PERFORM on tournament day." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#96FF00" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#141414" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#141414" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#ececec" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#fafafa" }
  ],
  "blocks": [
    {
      "type": "pro",
      "name": "Pro",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "Placeholder shown until you add one" },
        { "type": "text", "id": "fallback_filename", "label": "Bundled asset filename", "info": "Advanced: filename of an image already uploaded to the theme's assets folder, used when no Photo is picked above" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "PERFORM is part of my warm-up routine before every tournament match." },
        { "type": "text", "id": "name", "label": "Name", "info": "Placeholder only — replace with a real, permissioned endorsement before publishing", "default": "Marcus Reyes" },
        { "type": "text", "id": "credential", "label": "Credential", "default": "Pro Tour Player · PLACEHOLDER" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PZ Pro Endorsements",
      "blocks": [
        { "type": "pro", "settings": { "quote": "PERFORM is part of my warm-up routine before every tournament match.", "name": "Marcus Reyes", "credential": "Pro Tour Player · PLACEHOLDER" } },
        { "type": "pro", "settings": { "quote": "I stopped cramping in the third game once I switched to PERFORM.", "name": "Danielle Cho", "credential": "Pro Tour Player · PLACEHOLDER" } },
        { "type": "pro", "settings": { "quote": "Clean ingredients, real focus. This is what I recommend to my students.", "name": "Andre Whitfield", "credential": "Certified Coach · PLACEHOLDER" } }
      ]
    }
  ]
}
{% endschema %}
